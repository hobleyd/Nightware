@page "/account/password"
@model Nightware.Admin.Pages.Account.PasswordModel
@{ ViewData["Title"] = "Change password"; }
<h1>Change password</h1>
@switch (Model.Status)
{
    case "success":
        <p class="notice" role="status">Your password has been changed. Use it for the console and NightMail from now on.</p>
        <p><a asp-page="/Index">Back to the console</a></p>
        break;
    case "cancelled":
        <p class="warning" role="status">You cancelled; your password is unchanged.</p>
        break;
    case "error":
        <p class="warning" role="alert">Keycloak did not change your password. Try again, or ask another global administrator to reset it from your user page.</p>
        break;
}
@if (Model.Status != "success")
{
    <p>Keycloak asks you to choose a new password, and to sign in again first if your last sign-in was more than a few minutes ago. Then it brings you back here.</p>
    <form method="post">
        <button type="submit">Change my password</button>
    </form>
}
