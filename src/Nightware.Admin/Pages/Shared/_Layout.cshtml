@{
    var actor = (ViewData.Model as ConsolePageModel)?.Actor;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var page = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    var inEntities = page.StartsWith("/Entities/", StringComparison.Ordinal) || page.StartsWith("/Users/", StringComparison.Ordinal);
    var inAdmins = page.StartsWith("/Admins/", StringComparison.Ordinal);
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="referrer" content="no-referrer">
    <title>@(ViewData["Title"] is string t ? t + " · " : "")Nightware console</title>
    <meta name="theme-color" content="#121433">
    <link rel="icon" href="~/img/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png">
    <link rel="stylesheet" href="~/console.css" asp-append-version="true">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top">
    <a class="brand" asp-page="/Index"><img src="~/img/mark.png" width="28" height="28" alt="">Nightware console</a>
    @if (signedIn && actor?.IsAdmin == true)
    {
        <nav>
            <a asp-page="/Entities/Index" aria-current="@(inEntities ? "page" : null)">Entities</a>
            @if (actor.IsGlobal)
            {
                <a asp-page="/Admins/Index" aria-current="@(inAdmins ? "page" : null)">Global admins</a>
            }
        </nav>
        <form method="get" asp-page="/Users/Find" class="find" role="search">
            <label><span class="visually-hidden">Find a user</span><input type="search" name="q" placeholder="Find a user" autocomplete="off" required></label>
        </form>
    }
    @if (signedIn)
    {
        <form method="post" asp-page="/Account/SignOut" class="signout">
            <span class="who">@User.Identity!.Name@(actor?.IsGlobal == true ? " · global admin" : actor?.IsAdmin == true ? " · entity admin" : "")</span>
            <a asp-page="/Account/Password">Change password</a>
            <button type="submit" class="link">Sign out</button>
        </form>
    }
</header>
<main id="main">
    @{ var body = RenderBody(); }
    @* Pages place their messages under their heading; the body renders first, so this only catches pages that do not. *@
    @if (Context.Items["messages-shown"] is not true)
    {
        <partial name="_Messages" />
    }
    @body
</main>
</body>
</html>
