@{
    var actor = (ViewData.Model as ConsolePageModel)?.Actor;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var page = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    var sections = signedIn && actor?.IsAdmin == true;
}
@inject Nightware.Application.Administration.Entities.ListEntities ListEntities
@{
    // The menu is also the breadcrumb. A page names the way up to it in Crumbs (a section first, then its entity
    // and anything below it), the entity it sits under in EntityId, and its own entry in Here (else its title).
    var crumbs = (ViewData["Crumbs"] as IEnumerable<(string Text, string? Href)>)?.ToList() ?? [];
    var here = (ViewData["Here"] ?? ViewData["Title"]) as string ?? string.Empty;
    var entityId = ViewData["EntityId"] as string;
    var entitiesHref = Url.Page("/Entities/Index");
    var adminsHref = Url.Page("/Admins/Index");
    var under = crumbs.Count > 0 ? crumbs[0].Href : null;
    var self = Context.Request.PathBase + Context.Request.Path;

    // Every entity the actor manages; a list that cannot be read leaves just the section, plus the entity this page is under.
    var entities = new List<(string Id, string Name, IReadOnlyList<string> Domains)>();
    if (sections && await ListEntities.ExecuteAsync(Context.RequestAborted) is { IsSuccess: true } listed)
    {
        entities.AddRange(listed.Value.Select(e => (e.Id, e.Name, (IReadOnlyList<string>)[.. e.Domains.Select(d => d.Name)])));
    }

    var entityHref = entityId is null ? null : Url.Page("/Entities/Detail", new { id = entityId });
    var at = crumbs.FindIndex(c => c.Href == entityHref);
    if (entityId is not null && !entities.Any(e => e.Id == entityId))
    {
        entities.Add((entityId, at >= 0 ? crumbs[at].Text : here, []));
    }

    // What hangs below the entity (or below the section, when no entity is on the way), ending with this page.
    List<(string Text, string? Href)> below = entityId is null ? [.. crumbs.Skip(1), (here, self)]
        : at >= 0 ? [.. crumbs.Skip(at + 1), (here, self)]
        : [];

    void Chain(int i)
    {
        if (i >= below.Count) { return; }
        var last = i == below.Count - 1;
        <ul><li><a aria-current="@(last ? "page" : null)" class="@(last ? null : "trail")" href="@(last ? self : below[i].Href)">@below[i].Text</a>@{ Chain(i + 1); }</li></ul>
    }
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="referrer" content="no-referrer">
    <title>@(ViewData["Title"] is string t ? t + " · " : "")Nightware console</title>
    <meta name="theme-color" content="#121433" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#181c56" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="~/img/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png">
    <link rel="stylesheet" href="~/console.css" asp-append-version="true">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top">
    <a class="brand" asp-page="/Index"><img src="~/img/mark.png" width="28" height="28" alt="">Nightware console</a>
    @if (sections)
    {
        <form method="get" asp-page="/Users/Find" class="find" role="search">
            <label><span class="visually-hidden">Find a user</span><input type="search" name="q" placeholder="Find a user" autocomplete="off" required></label>
        </form>
    }
    @if (signedIn)
    {
        @* The account menu opens through the browser's own popover: plain HTML, so the CSP that blocks
           script does not block it, and a click outside or Escape closes it. *@
        <div class="account">
            <button type="button" class="who" popovertarget="account-menu">@User.Identity!.Name<span class="role">@(actor?.IsGlobal == true ? " · global admin" : actor?.IsAdmin == true ? " · entity admin" : "")</span><span class="caret" aria-hidden="true"></span></button>
            <div id="account-menu" popover class="menu">
                <a asp-page="/Account/Password">Change password</a>
                <a asp-page="/Account/Passkey">Add a passkey</a>
                <form method="post" asp-page="/Account/SignOut">
                    <button type="submit" class="link">Sign out</button>
                </form>
            </div>
        </div>
    }
</header>
<div class="@(sections ? "frame" : null)">
@if (sections)
{
    @* Only the page itself is aria-current; the way up to it is marked as the trail. *@
    <nav class="side panel" aria-label="Sections">
        <ul>
            <li><a asp-page="/Index" aria-current="@(page == "/Index" ? "page" : null)">Dashboard</a></li>
            <li><a asp-page="/Entities/Index" aria-current="@(page == "/Entities/Index" ? "page" : null)" class="@(under == entitiesHref ? "trail" : null)">Entities</a>
                @if (entities.Count > 0)
                {
                    <ul>
                        @foreach (var e in entities)
                        {
                            var on = e.Id == entityId;
                            var current = on && below.Count == 0;
                            // The entity's own pages are entries under it, in alphabetical order; a domain's DNS records are an entry under Domains,
                            // so on that page the domain is the current one and Domains is on the trail.
                            var domains = e.Domains.Select(d => (Name: d, Href: Url.Page("/Entities/Dns", new { id = e.Id, domain = d }))).ToList();
                            var parts = new[]
                            {
                                (Text: "Administrators", Href: Url.Page("/Entities/Admins", new { id = e.Id })),
                                (Text: "DNS hosting", Href: Url.Page("/Entities/DnsHosting", new { id = e.Id })),
                                (Text: "Domains", Href: Url.Page("/Entities/Detail", new { id = e.Id }) + "#domains"),
                            }.Select(p => (p.Text, p.Href,
                                Here: on && below.Count == 1 && string.Equals(p.Href, self, StringComparison.OrdinalIgnoreCase),
                                Trail: on && below.Count > 1 && below[0].Href == p.Href)).ToList();
                            var atDomain = on && below.Count == 2 && parts[2].Trail && domains.Any(d => string.Equals(d.Href, self, StringComparison.OrdinalIgnoreCase));
                            <li><a aria-current="@(current ? "page" : null)" class="@(on && !current ? "trail" : null)" href="@Url.Page("/Entities/Detail", new { id = e.Id })">@e.Name</a>
                                <ul class="entity">
                                    @foreach (var p in parts)
                                    {
                                        <li><a aria-current="@(p.Here ? "page" : null)" class="@(p.Trail ? "trail" : null)" href="@p.Href">@p.Text</a>
                                            @if (p.Text == "Domains" && domains.Count > 0)
                                            {
                                                <ul class="domains">
                                                    @foreach (var d in domains)
                                                    {
                                                        <li><a aria-current="@(atDomain && string.Equals(d.Href, self, StringComparison.OrdinalIgnoreCase) ? "page" : null)" href="@d.Href">@d.Name</a></li>
                                                    }
                                                </ul>
                                            }
                                            @if (p.Trail && !atDomain) { Chain(1); }
                                        </li>
                                    }
                                </ul>
                                @if (on && !parts.Any(p => p.Here || p.Trail)) { Chain(0); }
                            </li>
                        }
                    </ul>
                }
                @if (under == entitiesHref && entityId is null)
                {
                    Chain(0);
                }
            </li>
            @if (actor!.IsGlobal)
            {
                <li><a asp-page="/Admins/Index" aria-current="@(page == "/Admins/Index" ? "page" : null)" class="@(under == adminsHref ? "trail" : null)">Global admins</a>@if (under == adminsHref) { Chain(0); }</li>
            }
        </ul>
    </nav>
}
<main id="main" class="@(ViewData["Wide"] is true ? "wide" : null)">
    @{ var body = RenderBody(); }
    @* Pages place their messages under their heading; the body renders first, so this only catches pages that do not. *@
    @if (Context.Items["messages-shown"] is not true)
    {
        <partial name="_Messages" />
    }
    @body
</main>
</div>
</body>
</html>
