@page "/admins"
@model Nightware.Admin.Pages.Admins.IndexModel
@{ ViewData["Title"] = "Global administrators"; }
@if (Model.Unread is not null) { <partial name="_Unread" /> return; }
<h1>Global administrators</h1>
<partial name="_Messages" />
<p>They manage every entity, create entities and domains, and may delete a disabled user's data. To grant the role, <a asp-page="/Users/Find">find the user</a> and use their page; new administrators must set up an authenticator app, and can then add a passkey.</p>
<section class="panel" aria-label="Current global administrators">
<table>
    <thead><tr><th>Name</th><th>Address</th></tr></thead>
    <tbody>
    @foreach (var a in Model.Admins)
    {
        <tr>
            <td><a asp-page="/Users/Detail" asp-route-id="@a.Id">@a.DisplayName</a>@(a.Id == Model.Actor.UserId ? " (you)" : "")</td>
            <td data-label="Address">@a.Email</td>
        </tr>
    }
    </tbody>
</table>
</section>

@{ var removable = Model.Admins.Where(a => a.Id != Model.Actor.UserId).ToList(); }
@if (removable.Count > 0)
{
    <form method="post" asp-page-handler="Revoke" class="panel">
        <h2>Remove global administrator rights</h2>
        <div class="row">
            <label>Administrator
                <select name="userId">
                    @foreach (var a in removable)
                    {
                        <option value="@a.Id">@a.DisplayName (@a.Email)</option>
                    }
                </select>
            </label>
        </div>
        <label class="choice"><input type="checkbox" name="confirm" value="true" required> They will no longer manage every entity</label>
        <button type="submit" class="secondary">Remove rights</button>
    </form>
}
