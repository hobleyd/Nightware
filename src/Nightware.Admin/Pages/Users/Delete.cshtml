@page "/users/{id}/delete/{target}"
@model Nightware.Admin.Pages.Users.DeleteModel
@{
    // Entity › Users › person, as on the person's own page, whether or not the deletion is possible.
    var whose = Model.Subject?.User.Identity.DisplayName ?? (Model.Unread is null ? Model.Preview.User.Identity.DisplayName : null);
    var crumbs = new List<(string Text, string? Href)> { ("Entities", Url.Page("/Entities/Index")) };
    if (Model.EntityId is not null)
    {
        crumbs.Add((Model.EntityName ?? "Entity", Url.Page("/Entities/Detail", new { id = Model.EntityId })));
        crumbs.Add(("Users", Url.Page("/Users/Index", new { entity = Model.EntityId })));
    }

    crumbs.Add((whose ?? "User", Url.Page("/Users/Detail", new { id = Model.Id })));
    ViewData["Title"] = whose is null ? $"Delete {Model.What}" : $"Delete {Model.What} of {whose}";
    ViewData["Back"] = Url.Page("/Users/Detail", new { id = Model.Id });
    ViewData["Crumbs"] = crumbs;
}
@if (Model.Unread is not null)
{
    <partial name="_Unread" />
    @* The refusal names its fix; offer it here rather than one page away. *@
    @if (Model.MayFinishOffboarding)
    {
        <form method="post" asp-page="/Users/Detail" asp-route-id="@Model.Id" asp-page-handler="Offboard">
            <input type="hidden" name="confirm" value="true">
            <button type="submit">Finish offboarding</button> <span class="hint">Safe to repeat. Then come back to delete.</span>
        </form>
    }
    return;
}
@{
    var p = Model.Preview;
    var what = Model.What;
}
<nav class="crumbs" aria-label="Breadcrumb">@foreach (var c in crumbs) { <a href="@c.Href">@c.Text</a><text> › </text> }<span aria-current="page">Delete @what</span></nav>
<h1>Delete @what of @p.User.Identity.DisplayName</h1>
<partial name="_Messages" />

@if (p.AlreadyAbsent)
{
    <p>There is nothing to delete: it is already gone.</p>
}
else
{
    <section class="panel danger-zone">
        <h2>This permanently deletes</h2>
        <ul>
            @foreach (var item in p.Removes) { <li>@item</li> }
            @if (p.MailboxBytes is { } bytes) { <li>@((bytes / 1048576.0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) MB of stored mail</li> }
        </ul>
        <h2>It keeps</h2>
        <ul>
            @foreach (var item in p.Keeps) { <li>@item</li> }
        </ul>
        <form method="post">
            <label>Type <strong>@p.User.Identity.Email</strong> to confirm
                <input name="confirmation" autocomplete="off" required spellcheck="false">
            </label>
            <button type="submit" class="danger">Delete @what permanently</button>
        </form>
    </section>
}
