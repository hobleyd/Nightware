@page "/entities/{entity}/users"
@model Nightware.Admin.Pages.Users.IndexModel
@{ ViewData["Title"] = "Users"; ViewData["Crumbs"] = new (string, string?)[] { ("Entities", Url.Page("/Entities/Index")) }; }
@if (Model.Unread is not null) { <partial name="_Unread" /> return; }
@{ ViewData["Title"] = "Users of " + Model.Detail.Entity.Name; }
<nav class="crumbs" aria-label="Breadcrumb"><a asp-page="/Entities/Index">Entities</a> › <a asp-page="/Entities/Detail" asp-route-id="@Model.Entity">@Model.Detail.Entity.Name</a> › <span aria-current="page">Users</span></nav>
<h1>Users of @Model.Detail.Entity.Name</h1>
<partial name="_Messages" />
<form method="get" class="row">
    <label>Search <input name="q" value="@Model.Q" autocomplete="off"></label>
    <button type="submit" class="secondary">Filter</button>
    @if (!string.IsNullOrEmpty(Model.Q))
    {
        <a asp-page="/Users/Index" asp-route-entity="@Model.Entity">Show all</a>
    }
    <a class="button" asp-page="/Users/New" asp-route-entity="@Model.Entity">Add or link a user</a>
</form>

@if (Model.Users.Count == 0)
{
    <p>@(string.IsNullOrEmpty(Model.Q) ? "This entity has no users yet." : $"No users of {Model.Detail.Entity.Name} match “{Model.Q}”.")</p>
}
else
{
    <section class="panel">
    <table>
        <thead><tr><th>Name</th><th>Address</th><th>Status</th><th>Systems</th></tr></thead>
        <tbody>
        @foreach (var u in Model.Users)
        {
            <tr class="@(u.User.Identity.Enabled ? "" : "disabled")">
                <td><a asp-page="/Users/Detail" asp-route-id="@u.User.Identity.Id">@u.User.Identity.DisplayName</a></td>
                <td data-label="Address">@u.User.Identity.Email</td>
                <td data-label="Status"><partial name="_Status" model="u" /></td>
                <td data-label="Systems"><partial name="_Links" model="u.Links" view-data="@(new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["Offboarded"] = !u.User.Identity.Enabled })" /></td>
            </tr>
        }
        </tbody>
    </table>
    </section>
}
