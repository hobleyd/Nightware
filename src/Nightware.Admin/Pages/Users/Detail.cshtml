@page "/users/{id}"
@model Nightware.Admin.Pages.Users.DetailModel
@{ ViewData["Title"] = "User"; ViewData["Crumbs"] = new (string, string?)[] { ("Entities", Url.Page("/Entities/Index")) }; }
@if (Model.Unread is not null) { <partial name="_Unread" /> return; }
@{
    var u = Model.Subject.User;
    var id = u.Identity;
    var self = id.Id == Model.Actor.UserId;
    // The page's one primary action is the one this user's status calls for.
    var status = Nightware.Application.Administration.Users.UserStatuses.Of(Model.Subject);
    var incomplete = status == Nightware.Application.Administration.Users.UserStatus.OffboardingIncomplete;
    // Shown to a global admin so a listed conflict opens, but the console changes nothing on such an account.
    var offLimits = Model.Subject.OffLimits;
    ViewData["Title"] = id.DisplayName;
    // The menu's trail starts where the navigation does; someone in no entity is reached as a global administrator.
    ViewData["EntityId"] = u.EntityId;
    ViewData["Crumbs"] = u.EntityId is not null
        ? new (string, string?)[]
        {
            ("Entities", Url.Page("/Entities/Index")),
            (Model.EntityName ?? "Entity", Url.Page("/Entities/Detail", new { id = u.EntityId })),
            ("Users", Url.Page("/Users/Index", new { entity = u.EntityId })),
        }
        : u.IsGlobalAdmin && Model.Actor.IsGlobal ? new (string, string?)[] { ("Global admins", Url.Page("/Admins/Index")) }
        : null;
}
<section class="panel">
<h1>@id.DisplayName <small>@id.Email</small> <partial name="_Status" model="Model.Subject" /></h1>
<partial name="_Messages" />
<p>
    Username <code>@id.Username</code>
    @if (u.EntityId is not null)
    {
        <text> · <a asp-page="/Entities/Detail" asp-route-id="@u.EntityId">@(Model.EntityName ?? "entity")</a></text>
    }
    @if (u.IsGlobalAdmin) { <text> · <strong>global administrator</strong></text> }
    else if (u.IsEntityAdmin) { <text> · entity administrator</text> }
</p>
    <h2>Systems</h2>
    <table>
        <thead class="visually-hidden"><tr><th>System</th><th>State</th><th>Detail</th></tr></thead>
        <tbody>
        @foreach (var link in Model.Subject.Links)
        {
            var name = Systems.Name(link.Backend);
            <tr>
                <td>@name</td>
                <td data-label="State"><span class="chip @Systems.LinkClass(link, !id.Enabled)">@Systems.LinkLabel(link, !id.Enabled)</span></td>
                <td data-label="Detail">@if (link.State == LinkState.Error) { @Systems.FailedSentence(link.Backend) <span class="hint detail">@link.Detail</span> } else { @link.Detail }</td>
            </tr>
        }
        </tbody>
    </table>
    @* An incomplete offboarding says it in the Access panel, beside the button. *@
    @if (!Model.Actor.IsGlobal && !incomplete && Model.Subject.Links.Any(l => l.State == LinkState.Error))
    {
        <p class="hint">@Systems.TellOperator</p>
    }
    @if (offLimits is not null)
    {
        <p><strong>@offLimits</strong> The console shows this account but never changes it, so it offers no actions here.</p>
    }
    else if (id.Enabled)
    {
        <form method="post" asp-page-handler="Repair"><button type="submit" class="@(status == Nightware.Application.Administration.Users.UserStatus.NeedsRepair ? null : "secondary")">Repair</button> <span class="hint">Creates what is missing; never changes a conflicting account.</span></form>
    }
</section>

@if (Model.Credential is { } credential)
{
    <div class="secret">
        <p><strong>Temporary password — shown once.</strong> Give it to them by a channel other than this mailbox; they must change it at their next sign-in.</p>
        <p><code>@credential.Password</code></p>
    </div>
}

@if (!self && offLimits is null)
{
    @* An incomplete offboarding is this page's subject: the Access panel itself carries its colour, not a box inside it. *@
    <section class="panel@(incomplete ? " incomplete" : "")">
        <h2>Access</h2>
        @if (id.Enabled)
        {
            <form method="post" asp-page-handler="Offboard">
                <p>Offboarding disables sign-in everywhere and ends their sessions. Their mail keeps arriving and is kept, as are their files, calendars and contacts. It can be undone.</p>
                <label class="choice"><input type="checkbox" name="confirm" value="true" required> Offboard @id.DisplayName</label>
                <button type="submit" class="danger quiet">Offboard</button>
            </form>
        }
        else
        {
            var open = Nightware.Application.Administration.Users.OffboardUser.StillOpen(Model.Subject).ToList();
            if (open.Count > 0)
            {
                <p><strong>Offboarding incomplete.</strong> Sign-in is disabled, but these may still let them in:</p>
                <ul>
                    @foreach (var link in open)
                    {
                        <li>@Systems.Name(link.Backend): @if (link.State == LinkState.Error) { <text>it gave no answer, so it could not be shut.</text> <span class="hint detail">@link.Detail</span> } else { @link.Detail }</li>
                    }
                </ul>
                @* An entity admin cannot bring a failing system back: who to tell comes first, and the button that would
                   only fail again steps back to secondary until the system answers. *@
                var waiting = !Model.Actor.IsGlobal ? open.FirstOrDefault(l => l.State == LinkState.Error) : null;
                @if (waiting is not null)
                {
                    <p><strong>@Systems.WaitForOperator(waiting.Backend)</strong></p>
                }
                <form method="post" asp-page-handler="Offboard">
                    <input type="hidden" name="confirm" value="true">
                    <button type="submit" class="@(waiting is null ? null : "secondary")">Finish offboarding</button>
                    @if (waiting is null)
                    {
                        <span class="hint">Safe to repeat; run it again once the system is reachable.</span>
                    }
                </form>
            }
            else
            {
                <p>This user is offboarded: sign-in is disabled in every system.</p>
            }
            <form method="post" asp-page-handler="Reinstate" class="undo">
                <h3>Undo offboarding</h3>
                <p class="hint">Sign-in will work again in every system. Asks you to sign in again first.</p>
                @if (Model.Subject.For(BackendKind.Mail).State == LinkState.Missing)
                {
                    <label class="choice"><input type="checkbox" name="recreateMailbox" value="true"> Create a new, empty mailbox for @id.Email</label>
                }
                <label class="choice"><input type="checkbox" name="confirm" value="true" required> Reinstate @id.DisplayName</label>
                <button type="submit" class="secondary">Reinstate</button>
            </form>
        }
        @* What was done and what each system said straight after, kept on the user in Keycloak. *@
        @if (id.AccessHistory.Count > 0)
        {
            <div class="block">
                <h3>History</h3>
                <ol class="history">
                    @foreach (var e in id.AccessHistory)
                    {
                        <li><time datetime="@e.At.UtcDateTime.ToString("o", System.Globalization.CultureInfo.InvariantCulture)">@Systems.When(e.At)</time> · @Systems.HistoryLine(e)</li>
                    }
                </ol>
            </div>
        }
    </section>
}

@if (self)
{
    <section class="panel">
        <h2>Password</h2>
        <p>This is you: change your own password on <a asp-page="/Account/Password">Change password</a>. Administrators never reset their own password here.</p>
    </section>
}

@if (id.Enabled && !self && offLimits is null)
{
    <section class="panel">
        <h2>Password</h2>
        <form method="post" asp-page-handler="Reset" class="row">
            <button type="submit" name="delivery" value="@CredentialDelivery.TemporaryPassword" class="secondary">Generate a temporary password</button>
            <button type="submit" name="delivery" value="@CredentialDelivery.ActionEmail" class="secondary">E-mail a set-password link</button>
        </form>
    </section>

}

@if (!self && offLimits is null)
{
    @* Rare changes wait behind one summary, so the page leads with state, access and passwords. Granting global
       rights is for people who can sign in; an offboarded global admin can still have the rights removed. *@
    var aliases = id.Enabled;
    var rights = Model.Actor.IsGlobal && (u.IsGlobalAdmin || id.Enabled);
    @if (aliases || rights)
    {
        <details class="panel more" open="@(!ViewData.ModelState.IsValid ? "open" : null)">
            <summary><h2>More for @id.DisplayName</h2> <span class="hint">@string.Join(" and ", new[] { aliases ? "other addresses" : null, rights ? "administrator rights" : null }.Where(x => x is not null))</span></summary>
            @if (aliases)
            {
                <div class="block">
                    <h3>Other addresses</h3>
                    <form method="post" asp-page-handler="Aliases" class="row">
                        <label>Aliases <input name="aliases" value="@string.Join(", ", id.Aliases)" autocomplete="off"></label>
                        <button type="submit" class="secondary">Save</button>
                    </form>
                </div>
            }
            @if (rights)
            {
                <div class="block">
                    <h3>Administrator rights</h3>
                    @if (u.IsGlobalAdmin)
                    {
                        <form method="post" asp-page-handler="GlobalAdmin">
                            <p>@id.DisplayName is a global administrator.</p>
                            <label class="choice"><input type="checkbox" name="confirm" value="true" required> Remove @id.DisplayName's global administrator rights</label>
                            <button type="submit" name="grant" value="false" class="secondary">Remove global administrator rights</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="GlobalAdmin">
                            <p class="hint">A global administrator manages every entity, creates entities and domains, and may delete a disabled user's data. Granting it asks you to sign in again; they must set up an authenticator app, and can then add a passkey.</p>
                            <label class="choice"><input type="checkbox" name="confirm" value="true" required> Give @id.DisplayName global administrator rights</label>
                            <button type="submit" name="grant" value="true" class="secondary">Make global administrator</button>
                        </form>
                    }
                </div>
            }
        </details>
    }

    @* Held while an offboarding is incomplete: the Access panel above already says so, and offers the fix. *@
    @if (!id.Enabled && Model.MayDeleteData && !incomplete)
    {
        <section class="panel danger-zone">
            <h2>Danger zone</h2>
            <p>Deleting cannot be undone. Each deletion asks you to sign in again and to retype the address.</p>
            <a class="button danger" asp-page="/Users/Delete" asp-route-id="@id.Id" asp-route-target="@DeletionTarget.Mail">Delete mail…</a>
            <a class="button danger" asp-page="/Users/Delete" asp-route-id="@id.Id" asp-route-target="@DeletionTarget.GroupwareData">Delete files &amp; calendar data…</a>
        </section>
    }
}
