@page "/entities/{entity}/users/new"
@model Nightware.Admin.Pages.Users.NewModel
@{
    ViewData["Title"] = "Add or link a user";
    ViewData["Here"] = "Add or link";
    ViewData["EntityId"] = Model.Entity;
    ViewData["Crumbs"] = new (string, string?)[]
    {
        ("Entities", Url.Page("/Entities/Index")),
        ("Entity", Url.Page("/Entities/Detail", new { id = Model.Entity })),
        ("Users", Url.Page("/Users/Index", new { entity = Model.Entity })),
    };
}
@if (Model.Unread is not null) { <partial name="_Unread" /> return; }
<h1>Add or link a user — @Model.Detail.Entity.Name</h1>
<partial name="_Messages" />

@if (Model.Result is { } result)
{
    <section class="panel">
        @{ var partial = result.Links.Any(l => l.State == LinkState.Error); }
        <h2>@(partial ? "Partly done" : "Done"): @result.User.DisplayName &lt;@result.User.Email&gt;</h2>
        <partial name="_Links" model="result.Links" />
        @if (partial)
        {
            <p class="warning">Some systems could not be set up. Nothing that existed before was removed. Open the user and use <strong>Repair</strong> once the system is reachable.</p>
        }
        @if (result.Credential is { } credential)
        {
            <div class="secret">
                <p><strong>Temporary password — shown once.</strong> Give it to the person by a channel other than this mailbox. They must change it at first sign-in.</p>
                <p><code>@credential.Password</code></p>
            </div>
        }
        else if (result.CredentialError is { } error)
        {
            <p class="warning">The password could not be delivered: @error. Open the user and use <strong>Generate a temporary password</strong> or <strong>E-mail a set-password link</strong>.</p>
        }
        else if (Model.Form.Delivery == CredentialDelivery.ActionEmail)
        {
            <p>A set-password link was e-mailed to @result.User.Email.</p>
        }
        <p><a asp-page="/Users/Detail" asp-route-id="@result.User.Id">Open the user</a> · <a asp-page="/Users/New" asp-route-entity="@Model.Entity">Add another</a></p>
    </section>
}
else
{
    <form method="post" class="panel">
        <h2>Step 1 of 2: Who</h2>
        <div class="row">
            <label>First name <input asp-for="Form.FirstName" autocomplete="off"></label>
            <label>Last name <input asp-for="Form.LastName" autocomplete="off"></label>
        </div>
        <div class="row">
            <label>Address, before the @@ <input asp-for="Form.LocalPart" placeholder="carol.jones" autocomplete="off"></label>
            <label>Domain
                <select asp-for="Form.Domain">
                    @foreach (var d in Model.Detail.Entity.Domains)
                    {
                        <option value="@d.Name">@d.Name</option>
                    }
                </select>
            </label>
        </div>
        <label>Username <input asp-for="Form.Username" autocomplete="off"><span class="hint">Leave empty to use the part of the address before the @@. To link someone who can already sign in, enter their existing username.</span></label>
        <label>Other addresses (aliases) <input asp-for="Form.Aliases" placeholder="@("c.jones@" + Model.Form.Domain + ", sales@" + Model.Form.Domain)" autocomplete="off"><span class="hint">Optional. Separate with commas; each must be on one of this entity's domains.</span></label>
        <fieldset>
            <legend>First password</legend>
            <label class="choice"><input type="radio" asp-for="Form.Delivery" value="@CredentialDelivery.TemporaryPassword"> Generate a one-time password to give them (changed at first sign-in)</label>
            <label class="choice"><input type="radio" asp-for="Form.Delivery" value="@CredentialDelivery.ActionEmail"> E-mail a set-password link to the address (only if they can already read it)</label>
            <label class="choice"><input type="radio" asp-for="Form.Delivery" value="@CredentialDelivery.None"> None (they already have a password for signing in)</label>
        </fieldset>
        <button type="submit" asp-page-handler="Plan" class="secondary">Check what will happen</button>

        @if (Model.Plan is { } plan)
        {
            <h2>Step 2 of 2: What will happen</h2>
            <input type="hidden" name="Form.CheckedDetails" value="@Model.CurrentDetails">
            <partial name="_Plan" model="plan" />
            @if (plan.HasConflict)
            {
                <p class="warning">Nothing is created or linked while a conflict remains, and the console never merges accounts that disagree. Change the address or username above so it no longer collides, then check again; if the other account is really this person's, ask a global administrator to correct it in that system first.</p>
            }
            else
            {
                <button type="submit" asp-page-handler="Apply">Create and link</button>
            }
        }
    </form>
}
