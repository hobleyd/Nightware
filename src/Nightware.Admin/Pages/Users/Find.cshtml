@page "/users/find"
@model Nightware.Admin.Pages.Users.FindModel
@{ ViewData["Title"] = "Find a user"; }
@if (Model.Unread is not null) { <partial name="_Unread" /> return; }
<h1>Find a user</h1>
<partial name="_Messages" />
<form method="get" class="row" role="search">
    <label>Name, username or address <input name="q" value="@Model.Q" autocomplete="off" required></label>
    <button type="submit" class="secondary">Find</button>
</form>

@if (string.IsNullOrWhiteSpace(Model.Q))
{
    <p class="hint">Searches the users of every entity you manage.</p>
}
else if (Model.Found.Users.Count == 0)
{
    <p>Nobody in your entities matches “@Model.Q”.</p>
}
else
{
    <section class="panel" aria-label="Matches">
    <table>
        <thead><tr><th>Name</th><th>Address</th><th>Entity</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var f in Model.Found.Users)
        {
            var identity = f.User.User.Identity;
            <tr class="@(identity.Enabled ? "" : "disabled")">
                <td><a asp-page="/Users/Detail" asp-route-id="@identity.Id">@identity.DisplayName</a></td>
                <td data-label="Address">@identity.Email</td>
                <td data-label="Entity"><a asp-page="/Entities/Detail" asp-route-id="@f.Entity.Id">@f.Entity.Name</a></td>
                <td data-label="Status"><partial name="_Status" model="f.User" /></td>
            </tr>
        }
        </tbody>
    </table>
    </section>
    @if (Model.Found.Truncated)
    {
        <p class="hint">Showing the first @Nightware.Application.Administration.Users.FindUsers.Limit matches. Type more of the name or address to narrow the search.</p>
    }
}
