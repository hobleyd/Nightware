@page "/users/{id}/autoreply"
@model Nightware.Admin.Pages.Users.AutoReplyModel
@{ ViewData["Title"] = "Automatic replies"; }
@if (Model.Unread is not null) { <partial name="_Unread" /> return; }
<section class="panel">
    <h1>@Model.Name <small>automatic replies</small></h1>
    <partial name="_Messages" />
    <p>What people get back when they write to @Model.Name, as their own mail app would set it. They can change it themselves too.</p>
    <p><a asp-page="/Users/Detail" asp-route-id="@Model.Id">Back to @Model.Name</a></p>
</section>
<partial name="_AutoReplyForm" model="Model.Form" />
