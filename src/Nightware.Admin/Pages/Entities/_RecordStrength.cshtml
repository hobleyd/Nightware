@model IReadOnlyList<Nightware.Domain.Administration.MailAuthenticationWeakness>
@* An SPF or DMARC record the domain has, coloured by what it leaves open: green for nothing, amber for weak, red for
   unsafe. The reasons are the chip's tooltip and, for screen readers, its text. *@
<span class="chip @Systems.StrengthClass(Model)" title="@(Model.Count > 0 ? string.Join(" ", Model.Select(w => w.Message)) : null)">Present</span>@if (Model.Count > 0) { <span class="visually-hidden">, @Systems.WeaknessLabel(Model.Max(w => w.Severity)).ToLowerInvariant(): @string.Join(" ", Model.Select(w => w.Message))</span> }
