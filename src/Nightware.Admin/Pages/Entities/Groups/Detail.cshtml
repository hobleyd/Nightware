@page "/entities/{id}/groups/{groupId}"
@model Nightware.Admin.Pages.Entities.Groups.DetailModel
@{
    var detail = Model.Detail as Nightware.Application.Administration.Groups.GroupDetail;
    ViewData["Title"] = detail?.Group.Name ?? "Group";
    ViewData["Crumbs"] = new (string, string?)[]
    {
        ("Entities", Url.Page("/Entities/Index")),
        (detail?.Entity.Name ?? "Entity", Url.Page("/Entities/Detail", new { id = Model.Id })),
        ("Groups", Url.Page("/Entities/Groups/Index", new { id = Model.Id })),
    };
    ViewData["EntityId"] = Model.Id;
}
@if (Model.Unread is not null) { <partial name="_Unread" /> return; }
@{
    var group = Model.Detail.Group;
    var entity = Model.Detail.Entity;
}
<section class="panel">
    <h1>@group.Name <small>@entity.Name</small></h1>
    <partial name="_Messages" />
    <partial name="_GroupLinks" model="Model.Detail.Links" />
    @if (Model.Detail.Links.Any(l => l.State is LinkState.Missing or LinkState.Conflict or LinkState.Error))
    {
        <form method="post" asp-page-handler="Repair">
            <button type="submit" class="secondary">Repair</button>
            <span class="hint">Builds what is missing and brings the list and the Nextcloud group back in line with the members below.</span>
        </form>
    }
    @if (group.Mail is { } mail)
    {
        <p>Mail to <strong>@mail.Address</strong>@(mail.Aliases.Count > 0 ? $" (or {string.Join(", ", mail.Aliases.Select(a => a.Value))})" : "") reaches every member@(mail.ExternalRecipients.Count > 0 ? $" and {string.Join(", ", mail.ExternalRecipients.Select(r => r.Value))}" : ""). @(mail.Senders switch
            {
                SenderPolicy.Members => "Only members may send to it.",
                SenderPolicy.Organization => $"Anyone at {string.Join(" or ", entity.Domains.Select(d => d.Name))} may send to it.",
                _ => "Anyone may send to it.",
            })</p>
    }
</section>

<section class="panel">
    <h2>Members</h2>
    @if (Model.Detail.Members.Count == 0)
    {
        <p>None yet.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Name</th><th>Address</th><th></th></tr></thead>
            <tbody>
                @foreach (var m in Model.Detail.Members.OrderBy(m => m.DisplayName, StringComparer.CurrentCultureIgnoreCase))
                {
                    <tr>
                        <td data-label="Name"><a asp-page="/Users/Detail" asp-route-id="@m.Id">@m.DisplayName</a>@(m.Enabled ? "" : " (offboarded: receives nothing and sees no files until reinstated)")</td>
                        <td data-label="Address">@m.Email</td>
                        <td>
                            <form method="post" asp-page-handler="RemoveMember">
                                <input type="hidden" name="userId" value="@m.Id">
                                <button type="submit" class="secondary">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @if (Model.Candidates.Count > 0)
    {
        <form method="post" asp-page-handler="AddMember">
            <div class="row">
                <label>Add
                    <select name="userId">
                        @foreach (var u in Model.Candidates)
                        {
                            <option value="@u.User.Identity.Id">@u.User.Identity.DisplayName (@u.User.Identity.Email)</option>
                        }
                    </select>
                </label>
            </div>
            <button type="submit" class="secondary">Add member</button>
        </form>
    }
</section>

<section class="panel">
    <h2>Settings</h2>
    <form method="post" asp-page-handler="Save">
        <partial name="_GroupForm" model="(Model.Input!, entity, (Group?)group)" />
        <button type="submit">Save</button>
    </form>
</section>

<section class="panel danger">
    <h2>Delete</h2>
    @if (group.Files is { TeamFolder: true })
    {
        <p>The team folder and its files are kept when the group is deleted, shared with no one (Nextcloud administrators still see it).
            @if (Model.Actor.IsGlobal)
            {
                <a asp-page="/Entities/Groups/DeleteFolder" asp-route-id="@Model.Id" asp-route-groupId="@group.Id">Delete the team folder and its files</a>
            }
        </p>
    }
    <form method="post" asp-page-handler="Delete">
        <label class="choice"><input type="checkbox" name="confirm" value="true" required> Delete @group.Name: @(group.Mail is { } m ? $"mail to {m.Address} will be refused, and " : "")its members lose what was shared with the group</label>
        <button type="submit" class="secondary">Delete group</button>
    </form>
</section>
