@page "/entities/{id}/groups/new"
@model Nightware.Admin.Pages.Entities.Groups.NewModel
@{
    ViewData["Title"] = "New group";
    ViewData["Crumbs"] = new (string, string?)[]
    {
        ("Entities", Url.Page("/Entities/Index")),
        ((Model.Entity as Entity)?.Name ?? "Entity", Url.Page("/Entities/Detail", new { id = Model.Id })),
        ("Groups", Url.Page("/Entities/Groups/Index", new { id = Model.Id })),
    };
    ViewData["EntityId"] = Model.Id;
}
@if (Model.Unread is not null) { <partial name="_Unread" /> return; }
<section class="panel">
    <h1>New group <small>@Model.Entity.Name</small></h1>
    <partial name="_Messages" />
    <form method="post">
        <partial name="_GroupForm" model="(Model.Input, Model.Entity, (Group?)null)" />
        <p class="hint">Members are added on the group's page once it exists.</p>
        <button type="submit">Create group</button>
    </form>
</section>
