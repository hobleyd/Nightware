@page "/entities/{id}"
@model Nightware.Admin.Pages.Entities.DetailModel
@{ ViewData["Title"] = "Entity"; ViewData["Crumbs"] = new (string, string?)[] { ("Entities", Url.Page("/Entities/Index")) }; }
@if (Model.Unread is not null) { <partial name="_Unread" /> return; }
@{
    var entity = Model.Entity.Entity;
    ViewData["Title"] = entity.Name;
    var adminIds = Model.Admins.Select(a => a.Id).ToHashSet();
}
<nav class="crumbs" aria-label="Breadcrumb"><a asp-page="/Entities/Index">Entities</a> › <span aria-current="page">@entity.Name</span></nav>
<h1>@entity.Name <small>@entity.Alias</small></h1>
<partial name="_Messages" />
<p><a asp-page="/Users/Index" asp-route-entity="@entity.Id">@Model.Members.Count @(Model.Members.Count == 1 ? "user" : "users")</a> · <a asp-page="/Users/New" asp-route-entity="@entity.Id">Add or link a user</a></p>

<section class="panel">
    <h2>Mail domains</h2>
    <table>
        <thead><tr><th>Domain</th><th>Mail server</th><th>Signing (DKIM)</th><th>SPF</th><th>DMARC</th><th><span class="visually-hidden">Actions</span></th>@if (Model.Actor.IsGlobal) { <th><span class="visually-hidden">Remove</span></th> }</tr></thead>
        <tbody>
        @foreach (var d in Model.Entity.Domains)
        {
            <tr>
                <td><a asp-page="/Entities/Dns" asp-route-id="@entity.Id" asp-route-domain="@d.Domain.Name" title="@(Model.Actor.IsGlobal ? "DNS, SPF and DMARC" : "DNS records") for @d.Domain">@d.Domain</a></td>
                <td data-label="Mail server"><span class="chip @d.Mail.State.ToString().ToLowerInvariant()">@Systems.StateLabel(d.Mail.State)</span>@if (d.Mail.State != LinkState.Linked) { <span class="hint detail">@d.Mail.Detail</span> }</td>
                <td data-label="Signing (DKIM)">@if (d.Mail.State != LinkState.Linked) { <text>—</text> } else { <span class="chip @(d.DkimPresent ? "linked" : "missing")">@(d.DkimPresent ? "Keys present" : "Missing")</span> }</td>
                @{ var policy = entity.MailPolicyFor(d.Domain); }
                <td data-label="SPF">@if (policy.Spf is null) { <text>Mail server's</text> } else { <partial name="_RecordStrength" model="MailAuthenticationWeaknesses.Spf(policy.Spf.Value)" /> }</td>
                <td data-label="DMARC">@if (policy.Dmarc is null) { <text>Mail server's</text> } else { <partial name="_RecordStrength" model="MailAuthenticationWeaknesses.Dmarc(policy.Dmarc.Value)" /> }</td>
                <td class="actions">
                    @if (Model.Actor.IsGlobal)
                    {
                        @if (d.Mail.State != LinkState.Linked || !d.DkimPresent)
                        {
                            <form method="post" asp-page-handler="RepairDomain" class="inline"><input type="hidden" name="domain" value="@d.Domain.Name"><button type="submit" class="secondary">Repair</button></form>
                        }
                    }
                </td>
                @if (Model.Actor.IsGlobal)
                {
                    <td class="remove-cell">
                        @if (Model.AddressesOn(d.Domain) == 0)
                        {
                            @* The ✕ opens a confirmation through the browser's own popover: plain HTML, so the CSP that
                               forbids every script cannot switch it off. *@
                            var popover = "remove-" + d.Domain.Name.Replace('.', '-');
                            <button type="button" class="icon danger quiet" popovertarget="@popover" title="Remove @d.Domain.Name" aria-label="Remove @d.Domain.Name">&#x2715;</button>
                            <div id="@popover" popover class="confirm">
                                <form method="post" asp-page-handler="RemoveDomain">
                                    <input type="hidden" name="domain" value="@d.Domain.Name">
                                    <input type="hidden" name="confirm" value="true">
                                    <h3>Remove @d.Domain.Name from @entity.Name?</h3>
                                    <p class="hint">No user's address is on it. The mail server deletes the domain and its DKIM keys, and mail sent to it is no longer accepted here.</p>
                                    @if (entity.HasDnsToken)
                                    {
                                        <label class="choice"><input type="checkbox" name="cleanUpDns" value="true"> Also remove @d.Domain.Name's mail records from Cloudflare (only those that match what this console publishes)</label>
                                    }
                                    else
                                    {
                                        <p class="hint">Its DNS records at your provider are not touched.</p>
                                    }
                                    <div class="row">
                                        <button type="submit" class="danger">Remove domain</button>
                                        <button type="button" class="secondary" popovertarget="@popover" popovertargetaction="hide">Cancel</button>
                                    </div>
                                </form>
                            </div>
                        }
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Actor.IsGlobal && Model.Entity.Domains.Any(d => d.Mail.State != LinkState.Linked || !d.DkimPresent))
    {
        <p class="hint">Only your Nightware operator can repair a domain the mail server does not serve or lacks its signing keys.</p>
    }
    @if (Model.Actor.IsGlobal)
    {
        <form method="post" asp-page-handler="AddDomain" class="row">
            <label>Add domain <input name="domain" placeholder="acme.org" autocomplete="off" required></label>
            @* Adding the first domain is what a new entity is waiting for; after that it is a panel-local change. *@
            <button type="submit" class="@(Model.Entity.Domains.Count == 0 ? null : "secondary")">Add</button>
        </form>
    }
</section>

<section class="panel">
    <h2>DNS hosting</h2>
    @if (Model.Actor.IsGlobal)
    {
        <p>@(entity.HasDnsToken
            ? "Connected to Cloudflare. Publish each domain's records from its DNS page."
            : "Not connected. Connect the entity's Cloudflare account to publish its domains' records from their DNS pages.")</p>
        <form method="post" asp-page-handler="DnsToken">
            <label>@(entity.HasDnsToken ? "Replace the Cloudflare API token" : "Cloudflare API token")
                <input type="password" name="dnsToken" autocomplete="off" spellcheck="false" required aria-describedby="dns-token-hint">
            </label>
            <p id="dns-token-hint" class="hint">In Cloudflare, create an API token from the "Edit zone DNS" template, limited to this entity's zones. The console checks it with Cloudflare, stores it encrypted, and never shows it again.</p>
            <button type="submit" class="secondary">@(entity.HasDnsToken ? "Replace token" : "Connect")</button>
        </form>
        @if (entity.HasDnsToken)
        {
            <form method="post" asp-page-handler="RemoveDnsToken" class="remove">
                <label class="choice"><input type="checkbox" name="confirm" value="true" required> Forget the token; records already published stay in Cloudflare</label>
                <button type="submit" class="secondary">Disconnect Cloudflare</button>
            </form>
        }
    }
    else
    {
        <p>@(entity.HasDnsToken
            ? "Connected to Cloudflare: your Nightware operator publishes your domains' records there."
            : "Not connected: publish each domain's records at your DNS provider, as listed on its DNS page.")</p>
    }
</section>

<section class="panel">
    <h2>Entity administrators</h2>
    <p class="hint">They manage this entity's users. They cannot create entities, change domains or grant global rights.</p>
    @if (Model.Admins.Count == 0)
    {
        <p>None yet.</p>
    }
    <ul class="plain">
        @foreach (var a in Model.Admins)
        {
            <li>
                <a asp-page="/Users/Detail" asp-route-id="@a.Id">@a.DisplayName</a>@(a.Id == Model.Actor.UserId ? " (you)" : "") <span class="hint">@a.Email</span>
            </li>
        }
    </ul>
    @{ var candidates = Model.Members.Where(m => !adminIds.Contains(m.User.Identity.Id) && m.User.Identity.Enabled && m.User.Identity.Id != Model.Actor.UserId).ToList(); }
    @if (candidates.Count > 0)
    {
        <form method="post" asp-page-handler="GrantAdmin">
            <div class="row">
            <label>Make administrator
                <select name="userId">
                    @foreach (var m in candidates)
                    {
                        <option value="@m.User.Identity.Id">@m.User.Identity.DisplayName (@m.User.Identity.Email)</option>
                    }
                </select>
            </label>
            </div>
            <label class="choice"><input type="checkbox" name="confirm" value="true" required> They will manage this entity's users</label>
            <button type="submit" class="secondary">Make administrator</button>
        </form>
    }
    @{ var removable = Model.Admins.Where(a => a.Id != Model.Actor.UserId).ToList(); }
    @if (removable.Count > 0)
    {
        <form method="post" asp-page-handler="RevokeAdmin" class="remove">
            <h3>Remove an administrator</h3>
            <div class="row">
                <label>Administrator
                    <select name="userId">
                        @foreach (var a in removable)
                        {
                            <option value="@a.Id">@a.DisplayName (@a.Email)</option>
                        }
                    </select>
                </label>
            </div>
            <label class="choice"><input type="checkbox" name="confirm" value="true" required> They will no longer manage @entity.Name</label>
            <button type="submit" class="secondary">Remove administrator</button>
        </form>
    }
</section>
