@page "/entities/{id}"
@model Nightware.Admin.Pages.Entities.DetailModel
@{
    var entity = Model.Entity.Entity;
    ViewData["Title"] = entity.Name;
    var adminIds = Model.Admins.Select(a => a.Id).ToHashSet();
}
<nav class="crumbs" aria-label="Breadcrumb"><a asp-page="/Entities/Index">Entities</a> › <span aria-current="page">@entity.Name</span></nav>
<h1>@entity.Name <small>@entity.Alias</small></h1>
<p><a asp-page="/Users/Index" asp-route-entity="@entity.Id">@Model.Members.Count user(s)</a> · <a asp-page="/Users/New" asp-route-entity="@entity.Id">Add user</a></p>

<section class="panel">
    <h2>Mail domains</h2>
    <table>
        <thead><tr><th>Domain</th><th>Mail server</th><th>DKIM</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in Model.Entity.Domains)
        {
            <tr>
                <td>@d.Domain</td>
                <td><span class="chip @d.Mail.State.ToString().ToLowerInvariant()">@d.Mail.State</span>@if (d.Mail.State != LinkState.Linked) { <span class="hint detail">@d.Mail.Detail</span> }</td>
                <td>@(d.DkimPresent ? "Keys present" : "—")</td>
                <td class="actions">
                    <a asp-page="/Entities/Dns" asp-route-id="@entity.Id" asp-route-domain="@d.Domain.Name">DNS records</a>
                    @if (Model.Actor.IsGlobal)
                    {
                        @if (d.Mail.State != LinkState.Linked)
                        {
                            <form method="post" asp-page-handler="RepairDomain" class="inline"><input type="hidden" name="domain" value="@d.Domain.Name"><button type="submit">Repair</button></form>
                        }
                        <form method="post" asp-page-handler="RemoveDomain" class="inline"><input type="hidden" name="domain" value="@d.Domain.Name"><button type="submit" class="secondary">Remove</button></form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (Model.Actor.IsGlobal)
    {
        <form method="post" asp-page-handler="AddDomain" class="row">
            <label>Add domain <input name="domain" placeholder="acme.org" autocomplete="off" required></label>
            <button type="submit">Add</button>
        </form>
    }
</section>

<section class="panel">
    <h2>Entity administrators</h2>
    <p class="hint">They manage this entity's users. They cannot create entities, change domains or grant global rights.</p>
    @if (Model.Admins.Count == 0)
    {
        <p>None yet.</p>
    }
    <ul class="plain">
        @foreach (var a in Model.Admins)
        {
            <li>
                <a asp-page="/Users/Detail" asp-route-id="@a.Id">@a.DisplayName</a> &lt;@a.Email&gt;
                @if (a.Id != Model.Actor.UserId)
                {
                    <form method="post" asp-page-handler="RevokeAdmin" class="inline"><input type="hidden" name="userId" value="@a.Id"><button type="submit" class="secondary">Remove</button></form>
                }
            </li>
        }
    </ul>
    @{ var candidates = Model.Members.Where(m => !adminIds.Contains(m.User.Identity.Id) && m.User.Identity.Enabled && m.User.Identity.Id != Model.Actor.UserId).ToList(); }
    @if (candidates.Count > 0)
    {
        <form method="post" asp-page-handler="GrantAdmin" class="row">
            <label>Make administrator
                <select name="userId">
                    @foreach (var m in candidates)
                    {
                        <option value="@m.User.Identity.Id">@m.User.Identity.DisplayName (@m.User.Identity.Email)</option>
                    }
                </select>
            </label>
            <button type="submit">Grant</button>
        </form>
    }
</section>
