@page "/entities/{id}"
@model Nightware.Admin.Pages.Entities.DetailModel
@if (Model.Unread is not null) { <partial name="_Unread" /> return; }
@{
    var entity = Model.Entity.Entity;
    ViewData["Title"] = entity.Name;
    var adminIds = Model.Admins.Select(a => a.Id).ToHashSet();
}
<nav class="crumbs" aria-label="Breadcrumb"><a asp-page="/Entities/Index">Entities</a> › <span aria-current="page">@entity.Name</span></nav>
<h1>@entity.Name <small>@entity.Alias</small></h1>
<partial name="_Messages" />
<p><a asp-page="/Users/Index" asp-route-entity="@entity.Id">@Model.Members.Count @(Model.Members.Count == 1 ? "user" : "users")</a> · <a asp-page="/Users/New" asp-route-entity="@entity.Id">Add or link a user</a></p>

<section class="panel">
    <h2>Mail domains</h2>
    <table>
        <thead><tr><th>Domain</th><th>Mail server</th><th>DKIM</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in Model.Entity.Domains)
        {
            <tr>
                <td>@d.Domain</td>
                <td data-label="Mail server"><span class="chip @d.Mail.State.ToString().ToLowerInvariant()">@Systems.StateLabel(d.Mail.State)</span>@if (d.Mail.State != LinkState.Linked) { <span class="hint detail">@d.Mail.Detail</span> }</td>
                <td data-label="DKIM">@(d.DkimPresent ? "Keys present" : "—")</td>
                <td class="actions">
                    <a asp-page="/Entities/Dns" asp-route-id="@entity.Id" asp-route-domain="@d.Domain.Name">DNS records</a>
                    @if (Model.Actor.IsGlobal)
                    {
                        @if (d.Mail.State != LinkState.Linked || !d.DkimPresent)
                        {
                            <form method="post" asp-page-handler="RepairDomain" class="inline"><input type="hidden" name="domain" value="@d.Domain.Name"><button type="submit" class="secondary">Repair</button></form>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Actor.IsGlobal && Model.Entity.Domains.Any(d => d.Mail.State != LinkState.Linked))
    {
        <p class="hint">Only your Nightware operator can repair a domain the mail server does not serve.</p>
    }
    @if (Model.Actor.IsGlobal)
    {
        <form method="post" asp-page-handler="AddDomain" class="row">
            <label>Add domain <input name="domain" placeholder="acme.org" autocomplete="off" required></label>
            <button type="submit">Add</button>
        </form>
        @if (Model.Entity.Domains.Count > 0)
        {
            var removableDomains = Model.Entity.Domains.Where(d => Model.AddressesOn(d.Domain) == 0).ToList();
            <div class="remove">
                <h3>Remove a domain</h3>
                @if (removableDomains.Count == 0)
                {
                    <p class="hint">Every domain still has users' addresses on it (@string.Join(", ", Model.Entity.Domains.Select(d => $"{d.Domain}: {Model.AddressesOn(d.Domain)}"))). Change those addresses before removing a domain.</p>
                }
                else
                {
                    <form method="post" asp-page-handler="RemoveDomain">
                        <p class="hint">Takes the domain away from @entity.Name; the mail server keeps it. Only domains no user's address is on are listed.</p>
                        <div class="row">
                            <label>Domain
                                <select name="domain">
                                    @foreach (var d in removableDomains)
                                    {
                                        <option value="@d.Domain.Name">@d.Domain.Name</option>
                                    }
                                </select>
                            </label>
                        </div>
                        <label class="choice"><input type="checkbox" name="confirm" value="true" required> Remove it from @entity.Name</label>
                        <button type="submit" class="secondary">Remove domain</button>
                    </form>
                }
            </div>
        }
    }
</section>

<section class="panel">
    <h2>Entity administrators</h2>
    <p class="hint">They manage this entity's users. They cannot create entities, change domains or grant global rights.</p>
    @if (Model.Admins.Count == 0)
    {
        <p>None yet.</p>
    }
    <ul class="plain">
        @foreach (var a in Model.Admins)
        {
            <li>
                <a asp-page="/Users/Detail" asp-route-id="@a.Id">@a.DisplayName</a> &lt;@a.Email&gt;@(a.Id == Model.Actor.UserId ? " (you)" : "")
            </li>
        }
    </ul>
    @{ var candidates = Model.Members.Where(m => !adminIds.Contains(m.User.Identity.Id) && m.User.Identity.Enabled && m.User.Identity.Id != Model.Actor.UserId).ToList(); }
    @if (candidates.Count > 0)
    {
        <form method="post" asp-page-handler="GrantAdmin">
            <div class="row">
            <label>Make administrator
                <select name="userId">
                    @foreach (var m in candidates)
                    {
                        <option value="@m.User.Identity.Id">@m.User.Identity.DisplayName (@m.User.Identity.Email)</option>
                    }
                </select>
            </label>
            </div>
            <label class="choice"><input type="checkbox" name="confirm" value="true" required> They will manage this entity's users</label>
            <button type="submit">Make administrator</button>
        </form>
    }
    @{ var removable = Model.Admins.Where(a => a.Id != Model.Actor.UserId).ToList(); }
    @if (removable.Count > 0)
    {
        <form method="post" asp-page-handler="RevokeAdmin" class="remove">
            <h3>Remove an administrator</h3>
            <div class="row">
                <label>Administrator
                    <select name="userId">
                        @foreach (var a in removable)
                        {
                            <option value="@a.Id">@a.DisplayName (@a.Email)</option>
                        }
                    </select>
                </label>
            </div>
            <label class="choice"><input type="checkbox" name="confirm" value="true" required> They will no longer manage @entity.Name</label>
            <button type="submit" class="secondary">Remove administrator</button>
        </form>
    }
</section>
