@page "/entities/{id}/dns/{domain}"
@model Nightware.Admin.Pages.Entities.DnsModel
@{
    ViewData["Title"] = "DNS records for " + Model.Domain;
    // Record values are long: this page uses the window's width rather than the reading column.
    ViewData["Wide"] = true;
    // Kept when the records cannot be read: the entity's name is known if only the mail server failed.
    ViewData["Crumbs"] = new (string, string?)[]
    {
        ("Entities", Url.Page("/Entities/Index")),
        ((Model.Entity as Nightware.Application.Administration.Entities.EntityDetail)?.Entity.Name ?? "Entity", Url.Page("/Entities/Detail", new { id = Model.Id })),
    };
}
@if (Model.Unread is not null) { <partial name="_Unread" /> return; }
<nav class="crumbs" aria-label="Breadcrumb"><a asp-page="/Entities/Index">Entities</a> › <a asp-page="/Entities/Detail" asp-route-id="@Model.Id">@Model.Entity.Entity.Name</a> › <span aria-current="page">DNS records for @Model.Domain</span></nav>
<h1>DNS records for @Model.Domain</h1>
<partial name="_Messages" />

@if (Model.Repairable)
{
    <div class="warning">
        <p>@(Model.Status.Mail.State == LinkState.Linked
            ? $"The mail server serves {Model.Domain} but has not loaded its signing (DKIM) keys, so the records below are incomplete and outgoing mail cannot be signed."
            : $"The mail server does not serve {Model.Domain} yet, so there are no records to publish. {Model.Status.Mail.Detail}")</p>
        @if (Model.Actor.IsGlobal)
        {
            <form method="post" asp-page-handler="Repair"><button type="submit" class="secondary">Repair</button><span class="hint">Creates the domain on the mail server, or reloads it so its keys are loaded. Safe to repeat.</span></form>
        }
        else
        {
            <p>Ask your Nightware operator to repair the domain.</p>
        }
    </div>
}

@{
    // Steps appear only when there is something to do: deciding SPF and DMARC while the domain has not, or on Edit;
    // publishing while Cloudflare differs. Otherwise the page is the records as they stand, read-only.
    var global = Model.Actor.IsGlobal;
    var plan = Model.Publication?.Plan;
    var showPolicy = global && Model.ShowPolicyForm;
    var showPublish = global && (plan?.HasWork == true || Model.PublicationUnread is not null);
    var numbered = showPolicy && showPublish;
    ViewData["PolicyStep"] = numbered ? "1. " : "";
    // Deciding is the page's only step: its Save is the primary action.
    ViewData["PolicyPrimary"] = showPolicy && !showPublish;
}
@if (showPolicy)
{
    @* Decided first, so what is published below already carries it. *@
    <partial name="_MailPolicy" model="Model" />
}

@if (showPublish)
{
    <section class="panel">
        <h2>@(numbered ? "2. " : "")Publish to Cloudflare</h2>
        @if (Model.PublicationUnread is not null)
        {
            <div class="warning"><p>The Cloudflare zone could not be compared: @Model.PublicationUnread.Message</p></div>
        }
        else if (plan is not null)
        {
            var shown = plan.Changes.Where(c => c.Kind != DnsChangeKind.Unchanged).ToList();
            var published = plan.Count(DnsChangeKind.Unchanged);
            <p>Zone @plan.Zone.Name. @(published == 1 ? "1 record is" : $"{published} records are") already published as needed.</p>
            <table class="dns changes">
                <colgroup><col class="change"><col class="type"><col class="name"><col class="value"><col class="value"></colgroup>
                <thead><tr><th>Change</th><th>Type</th><th>Name</th><th>Value</th><th>In Cloudflare now</th></tr></thead>
                <tbody>
                @foreach (var c in shown)
                {
                    var record = c.Desired ?? c.Current!.Record;
                    <tr>
                        <td data-label="Change">@Systems.DnsChangeLabel(c.Kind)@if (c.Note is not null) { <span class="hint detail">@c.Note</span> }</td>
                        <td data-label="Type">@record.Type</td>
                        <td data-label="Name">@record.Name</td>
                        <td data-label="Value">@if (c.Desired is not null) { <textarea readonly rows="@Systems.ValueRows(c.Desired.Value)" aria-label="@($"{record.Type} value to publish at {record.Name}")">@c.Desired.Value</textarea> } else { <text>—</text> }</td>
                        <td data-label="In Cloudflare now">@if (c.Current is not null) { <textarea readonly rows="@Systems.ValueRows(c.Current.Record.Value)" aria-label="@($"{record.Type} value in Cloudflare now at {record.Name}")">@c.Current.Record.Value</textarea> } else { <text>—</text> }</td>
                    </tr>
                }
                </tbody>
            </table>
            @foreach (var warning in plan.Warnings)
            {
                <div class="warning"><p>@warning</p></div>
            }
            var writes = plan.Changes.Count(c => c.IsWrite);
            <form method="post" asp-page-handler="Publish">
                <input type="hidden" asp-for="PlanFingerprint">
                @if (plan.MailServersRemoved is { Count: > 0 } others)
                {
                    <label class="choice"><input type="checkbox" name="ConfirmMailMove" value="true" required> All mail for @Model.Domain comes here: @string.Join(" and ", others) @(others.Count == 1 ? "stops" : "stop") receiving it</label>
                }
                <button type="submit">Publish @writes @(writes == 1 ? "change" : "changes")</button><span class="hint">@(plan.Count(DnsChangeKind.Remove) > 0 ? "Makes exactly the changes listed. Nothing else in the zone is touched." : "Adds and corrects these records. Nothing else in the zone is removed.")</span>
            </form>
        }
    </section>
}

@if (Model.Records.Count == 0)
{
    @if (!Model.Repairable)
    {
        <p>The mail server serves @Model.Domain with its signing keys but returned no records for it. Repair would not change that. @(global ? "Check the domain in the mail server's own settings." : "Tell your Nightware operator.")</p>
    }
}
else
{
    <section class="panel" id="records">
        @* While a decision is open above, these are what is published now, not what Save will make them. *@
        <h2>@(showPolicy ? "In use now (before you save)" : $"Records for {Model.Domain}")</h2>
        @if (global && plan is { HasWork: false })
        {
            <p><span class="chip linked">Published</span> Cloudflare zone @plan.Zone.Name has every record @Model.Domain needs.</p>
        }
        else if (global && !Model.Entity.Entity.HasDnsToken)
        {
            <p class="hint">Publish these at your DNS provider so mail for @Model.Domain is delivered here and passes SPF, DKIM and DMARC checks. Select a value to copy it. To publish from here instead, connect @Model.Entity.Entity.Name's Cloudflare account on <a asp-page="/Entities/Detail" asp-route-id="@Model.Id">the entity's page</a>.</p>
        }
        else if (!global)
        {
            <p class="hint">Publish these at your DNS provider so mail for @Model.Domain is delivered here and passes SPF, DKIM and DMARC checks. Select a value to copy it. Only your Nightware operator can change SPF and DMARC.</p>
        }
        @if (global && !showPolicy)
        {
            <p><a class="button secondary" asp-route-edit="true" asp-fragment="mail-policy">Edit SPF and DMARC</a></p>
        }
        <partial name="_DnsRecords" model="Model.Records" view-data="@(new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["EditUrl"] = global && !showPolicy ? Url.Page("/Entities/Dns", null, new { id = Model.Id, domain = Model.Domain, edit = true }, null, null, "mail-policy") : null })" />
    </section>
}
