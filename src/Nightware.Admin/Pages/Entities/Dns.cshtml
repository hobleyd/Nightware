@page "/entities/{id}/dns/{domain}"
@model Nightware.Admin.Pages.Entities.DnsModel
@{ ViewData["Title"] = "DNS for " + Model.Domain; }
<nav class="crumbs" aria-label="Breadcrumb"><a asp-page="/Entities/Index">Entities</a> › <a asp-page="/Entities/Detail" asp-route-id="@Model.Id">@(Model.EntityName ?? "Entity")</a> › <span aria-current="page">DNS for @Model.Domain</span></nav>
<h1>DNS records for @Model.Domain</h1>
<p class="hint">Publish these at your DNS provider so mail for @Model.Domain is delivered here and your outgoing mail passes SPF, DKIM and DMARC checks. Select a value to copy it.</p>

@if (Model.Records.Count == 0)
{
    <p>The mail server has no records for this domain yet. Use Repair on the entity page.</p>
}
else
{
    <table class="dns">
        <thead><tr><th>Type</th><th>Name</th><th>TTL</th><th>Value</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Records.OrderBy(r => r.Type, StringComparer.Ordinal).ThenBy(r => r.Name, StringComparer.Ordinal))
        {
            <tr>
                <td data-label="Type">@r.Type</td>
                <td data-label="Name"><input readonly value="@r.Name" aria-label="Name"></td>
                <td data-label="TTL">@r.Ttl</td>
                <td data-label="Value"><textarea readonly rows="@(r.Value.Length > 80 ? 3 : 1)" aria-label="Value">@r.Value</textarea></td>
            </tr>
        }
        </tbody>
    </table>
}
