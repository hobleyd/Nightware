@page "/entities"
@model Nightware.Admin.Pages.Entities.IndexModel
@{ ViewData["Title"] = "Entities"; }
<h1>Entities</h1>

<table>
    <thead><tr><th>Entity</th><th>Short name</th><th>Domains</th><th></th></tr></thead>
    <tbody>
    @foreach (var e in Model.Entities)
    {
        <tr>
            <td><a asp-page="/Entities/Detail" asp-route-id="@e.Id">@e.Name</a></td>
            <td>@e.Alias</td>
            <td>@string.Join(", ", e.Domains.Select(d => d.Name))</td>
            <td><a asp-page="/Users/Index" asp-route-entity="@e.Id">Users</a></td>
        </tr>
    }
    </tbody>
</table>

@if (Model.Actor.IsGlobal)
{
    <section class="panel">
        <h2>New entity</h2>
        <p class="hint">Creates the organisation in Keycloak and its mail domain (with DKIM keys) on the mail server. A domain can belong to one entity only.</p>
        <form method="post">
            <label>Name <input asp-for="Form.Name" placeholder="Acme Pty Ltd" autocomplete="off"></label>
            <label>Short name <input asp-for="Form.Alias" placeholder="acme" autocomplete="off"><span class="hint">lower-case letters, digits and hyphens</span></label>
            <label>Mail domain <input asp-for="Form.Domain" placeholder="acme.com.au" autocomplete="off"></label>
            <button type="submit">Create entity</button>
        </form>
    </section>
}
