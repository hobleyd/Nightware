@page "/entities"
@model Nightware.Admin.Pages.Entities.IndexModel
@{ ViewData["Title"] = "Entities"; }
@if (Model.Unread is not null) { <partial name="_Unread" /> return; }
<section class="panel">
<h1>Entities</h1>
<partial name="_Messages" />
@if (Model.Actor.IsGlobal)
{
    @* A form cannot sit inside a table row, so the new row's fields join it through their form attribute. *@
    <form id="new-entity" method="post"></form>
}
<table aria-label="All entities" class="adds">
    <thead><tr><th>Entity</th><th>Short name</th><th>Domains</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
    <tbody>
    @foreach (var e in Model.Entities)
    {
        <tr>
            <td><a asp-page="/Entities/Detail" asp-route-id="@e.Id">@e.Name</a></td>
            <td data-label="Short name">@e.Alias</td>
            <td data-label="Domains">@string.Join(", ", e.Domains.Select(d => d.Name))</td>
            <td><a asp-page="/Users/Index" asp-route-entity="@e.Id">Users</a></td>
        </tr>
    }
    </tbody>
    @if (Model.Actor.IsGlobal)
    {
        <tfoot>
            <tr class="add-row">
                <td data-label="New entity" class="wide"><input asp-for="Form.Name" form="new-entity" aria-label="New entity's name" placeholder="Acme Pty Ltd" autocomplete="off"></td>
                <td data-label="Short name"><input asp-for="Form.Alias" form="new-entity" aria-label="New entity's short name" aria-describedby="new-entity-hint" placeholder="acme" autocomplete="off"></td>
                <td data-label="Mail domain"><input asp-for="Form.Domain" form="new-entity" aria-label="New entity's mail domain" placeholder="acme.com.au" autocomplete="off"></td>
                <td class="add-cell"><button type="submit" form="new-entity" class="icon" title="Create entity" aria-label="Create entity">&#x2B;</button></td>
            </tr>
        </tfoot>
    }
</table>
@if (Model.Actor.IsGlobal)
{
    <p class="hint" id="new-entity-hint">The last row creates an entity for sign-in and its mail domain, with signing (DKIM) keys, on the mail server. A short name is lower-case letters, digits and hyphens; a domain can belong to one entity only.</p>
}
</section>
