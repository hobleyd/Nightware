@model Nightware.Admin.Pages.Entities.DnsModel
@* The domain's SPF and DMARC choice, for a global administrator: shown while the domain has none of its own, or on Edit. *@
@if (Model.SpfUnderReview is { } reviewed)
{
    @* The SPF record just posted, shown back before it is saved: the box describes this record and no other. *@
    var meaning = Systems.SpfMeaning(reviewed, Model.Domain);
    <section class="panel" id="spf-review">
        <h2>Use this SPF record?</h2>
        <p><code>@reviewed.Value</code></p>
        @foreach (var w in Nightware.Domain.Administration.MailAuthenticationWeaknesses.Spf(reviewed.Value))
        {
            <p class="weakness"><span class="chip @Systems.WeaknessClass(w.Severity)">@Systems.WeaknessLabel(w.Severity)</span> @w.Message</p>
        }
        <form method="post" asp-page-handler="MailPolicy">
            <input type="hidden" name="Spf" value="@reviewed.Value">
            <input type="hidden" name="Dmarc" value="@Model.Dmarc">
            <label class="choice"><input type="checkbox" name="ConfirmSpf" value="true" required> @meaning</label>
            <button type="submit">Use this SPF record</button>
        </form>
        <p class="hint">Or change it below and save again.</p>
    </section>
}
<section class="panel" id="mail-policy">
    <h2>@ViewData["PolicyStep"]Decide SPF and DMARC</h2>
    <details class="teach">
        <summary>How SPF and DMARC work</summary>
        <p>SPF lists the servers allowed to send mail for @Model.Domain. DMARC tells receiving servers what to do with mail that fails SPF and DKIM, and where to send reports. Unless you set your own, the domain uses the mail server's records.</p>
        <p>An SPF record such as <code>v=spf1 mx -all</code> lets only the listed senders through; add <code>include:</code> for any other service that sends as @Model.Domain. A DMARC record such as <code>v=DMARC1; p=quarantine; rua=mailto:postmaster@@@Model.Domain</code> says what happens to mail that fails: while other services still send as @Model.Domain, a gentler <code>p=none</code> only reports failures instead of refusing them. Reports sent to a <code>rua=</code> address need a mailbox there.</p>
    </details>
    @if (Model.Actor.IsGlobal)
    {
        <form method="post" asp-page-handler="MailPolicy">
            @* Each record reads as one row: what is in use now (with what it leaves open), the field, and any suggestion. *@
            <div id="spf-now"><partial name="_RecordNow" model="(Model.Policy.Spf is null, Model.SpfInUse)" /></div>
            <label>SPF record
                <textarea asp-for="Spf" rows="2" class="mono" aria-describedby="@(Model.SpfSuggested ? "spf-now spf-suggested blank-hint" : "spf-now blank-hint")"></textarea>
            </label>
            @if (Model.SpfSuggested && Model.Suggestion is { } s)
            {
                <p id="spf-suggested" class="suggested">Suggested, not in use until you save: only @(s.Addresses.Count > 0 ? "this server's public " + (s.Addresses.Count == 1 ? "address" : "addresses") : "the domain's MX hosts") may send, and other senders are refused.
                    @switch (s.Source)
                    {
                        case Nightware.Application.Administration.Entities.PublicAddressSource.Zone:
                            <text>The address comes from the A/AAAA records for @s.Host in the entity's zone at its DNS host.</text>
                            break;
                        case Nightware.Application.Administration.Entities.PublicAddressSource.PublicDns:
                            <text>The address comes from public DNS for @s.Host. Behind NAT, mail can leave from a different address: check it.</text>
                            break;
                        case Nightware.Application.Administration.Entities.PublicAddressSource.Proxied:
                            <text>Cloudflare proxies @s.Host, so its addresses are Cloudflare's, not this server's. Enter the server's own address with <code>ip4:</code> if you know it.</text>
                            break;
                        default:
                            <text>@(s.Host is null ? "No public host is configured" : $"No public address was found for {s.Host}"), so the MX hosts stand in. Enter the server's own address with <code>ip4:</code> if you know it.</text>
                            break;
                    }
                </p>
            }
            <div id="dmarc-now"><partial name="_RecordNow" model="(Model.Policy.Dmarc is null, Model.DmarcInUse)" /></div>
            <label>DMARC record
                <textarea asp-for="Dmarc" rows="2" class="mono" aria-describedby="@(Model.DmarcSuggested ? "dmarc-now dmarc-suggested blank-hint" : "dmarc-now blank-hint")"></textarea>
            </label>
            @if (Model.DmarcSuggested)
            {
                <p id="dmarc-suggested" class="suggested">Suggested, not in use until you save: mail that fails is refused, for subdomains too, and both checks must match the domain exactly. Reports go to postmaster@@@Model.Domain.</p>
            }
            <p id="blank-hint" class="hint">Leave a field blank to keep the mail server's record. @(Model.SpfSuggested || Model.DmarcSuggested ? "Saving makes both fields this domain's own records, suggestions included." : "")</p>
            <button type="submit" class="@(ViewData["PolicyPrimary"] is true ? null : "secondary")">Save</button>
        </form>
        @if (!Model.Policy.IsDefault)
        {
            <form method="post" asp-page-handler="DefaultMailPolicy">
                <button type="submit" class="secondary">Use the mail server's records</button>
            </form>
        }
        @if (Model.Edit)
        {
            <p><a asp-route-edit="" asp-fragment="records">Cancel</a></p>
        }
    }
</section>
