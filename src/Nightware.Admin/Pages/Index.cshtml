@page
@model IndexModel
@{ ViewData["Title"] = "Dashboard"; }
<h1>Dashboard</h1>

<section class="panel">
    <h2>Systems</h2>
    <ul class="chips">
        @foreach (var h in Model.Health)
        {
            var name = Systems.Name(h.Backend);
            <li class="chip @(h.Healthy ? "linked" : "error")">@name: @(h.Healthy ? "OK" : "Unavailable")</li>
        }
    </ul>
    @foreach (var h in Model.Health.Where(h => !h.Healthy && !string.IsNullOrEmpty(h.Detail)))
    {
        <p class="hint detail">@Systems.Name(h.Backend): @h.Detail</p>
    }
</section>

<section class="panel">
    <h2>@(Model.Actor.IsGlobal ? "Entities" : "Your entities")</h2>
    @if (Model.Entities.Count == 0)
    {
        <p>No entities yet. @if (Model.Actor.IsGlobal) { <a asp-page="/Entities/Index">Create the first one</a> }</p>
    }
    else
    {
        <table>
            <thead><tr><th>Entity</th><th>Domains</th><th></th></tr></thead>
            <tbody>
            @foreach (var e in Model.Entities)
            {
                <tr>
                    <td><a asp-page="/Entities/Detail" asp-route-id="@e.Id">@e.Name</a></td>
                    <td data-label="Domains">@string.Join(", ", e.Domains.Select(d => d.Name))</td>
                    <td><a asp-page="/Users/Index" asp-route-entity="@e.Id">Users</a> · <a asp-page="/Users/New" asp-route-entity="@e.Id">Add or link a user</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
