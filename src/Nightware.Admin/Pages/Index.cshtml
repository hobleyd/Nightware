@page
@model IndexModel
@{ ViewData["Title"] = "Dashboard"; }
@if (Model.Unread is not null) { <partial name="_Unread" /> return; }
<div class="dashboard">
<div class="dashboard-main">
@* The top bar names the page; the heading stays for screen readers so the panes start level. *@
<h1 class="visually-hidden">Dashboard</h1>
<partial name="_Messages" />

<section class="panel attention">
    <h2>Needs attention</h2>
    @if (Model.Attention.IsClear)
    {
        <p>Nothing needs you. Every user and domain in @(Model.Actor.IsGlobal ? "every entity" : "your entities") is in order.</p>
    }
    else
    {
        @if (Model.Attention.Users.Count > 0)
        {
            <table>
                <thead><tr><th>User</th><th>Entity</th><th>Status</th><th>What is wrong</th><th><span class="visually-hidden">Fix</span></th></tr></thead>
                <tbody>
                @foreach (var a in Model.Attention.Users)
                {
                    var identity = a.User.User.Identity;
                    <tr>
                        <td><a asp-page="/Users/Detail" asp-route-id="@identity.Id">@identity.DisplayName</a></td>
                        <td data-label="Entity">@a.Entity.Name</td>
                        <td data-label="Status"><partial name="_Status" model="a.User" /></td>
                        <td data-label="What is wrong">
                            @* An offboarded user's problem is what may still let them in; an active user's is what is missing or disagrees. *@
                            @{
                                var wrong = a.Status == Nightware.Application.Administration.Users.UserStatus.OffboardingIncomplete
                                    ? Nightware.Application.Administration.Users.OffboardUser.StillOpen(a.User)
                                    : a.User.Links.Where(l => l.Backend != BackendKind.Identity && l.State is LinkState.Missing or LinkState.Error or LinkState.Conflict);
                            }
                            @foreach (var link in wrong)
                            {
                                @if (link.State == LinkState.Error)
                                {
                                    <span class="detail">@Systems.FailedSentence(link.Backend) <span class="hint">@link.Detail</span></span>
                                }
                                else
                                {
                                    <span class="detail">@Systems.ShortName(link.Backend): @Systems.StateLabel(link.State)@if (link.State == LinkState.Conflict && !string.IsNullOrEmpty(link.Detail)) { <span class="hint"> · @link.Detail</span> }</span>
                                }
                            }
                            @if (!Model.Actor.IsGlobal && wrong.Any(l => l.State == LinkState.Error))
                            {
                                <span class="detail hint">@(a.Status == Nightware.Application.Administration.Users.UserStatus.OffboardingIncomplete && wrong.FirstOrDefault(l => l.State == LinkState.Error) is { } failing
                                    ? Systems.WaitForOperator(failing.Backend)
                                    : Systems.TellOperator)</span>
                            }
                        </td>
                        <td class="actions">
                            @switch (a.Status)
                            {
                                case Nightware.Application.Administration.Users.UserStatus.OffboardingIncomplete:
                                    <form method="post" asp-page-handler="FinishOffboarding" class="inline"><input type="hidden" name="userId" value="@identity.Id"><button type="submit" class="secondary">Finish offboarding</button></form>
                                    break;
                                case Nightware.Application.Administration.Users.UserStatus.NeedsRepair:
                                    <form method="post" asp-page-handler="RepairUser" class="inline"><input type="hidden" name="userId" value="@identity.Id"><button type="submit" class="secondary">Repair</button></form>
                                    break;
                                default:
                                    <a class="button secondary" asp-page="/Users/Detail" asp-route-id="@identity.Id">Resolve on their page</a>
                                    break;
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        @if (Model.Attention.Domains.Count > 0)
        {
            <ul class="plain">
                @foreach (var d in Model.Attention.Domains)
                {
                    var served = d.Domain.Mail.State == LinkState.Linked;
                    <li>
                        <a asp-page="/Entities/Detail" asp-route-id="@d.Entity.Id">@d.Domain.Domain</a> (@d.Entity.Name): @string.Join("; ", new[]
                        {
                            !served ? $"the mail server does not serve it ({Systems.StateLabel(d.Domain.Mail.State)})" : served && !d.Domain.DkimPresent ? "no signing (DKIM) keys" : null,
                            d.Unsafe.Count > 0 ? "its SPF lets any server send mail as it" : null,
                        }.Where(static x => x is not null))
                        @if (Model.Actor.IsGlobal && d.Unsafe.Count > 0)
                        {
                            <a asp-page="/Entities/Dns" asp-route-id="@d.Entity.Id" asp-route-domain="@d.Domain.Domain.Name" asp-route-edit="true" asp-fragment="mail-policy">Fix SPF and DMARC</a>
                        }
                        @if (d.NeedsRepair && Model.Actor.IsGlobal)
                        {
                            <form method="post" asp-page-handler="RepairDomain" class="inline"><input type="hidden" name="entityId" value="@d.Entity.Id"><input type="hidden" name="domain" value="@d.Domain.Domain.Name"><button type="submit" class="secondary">Repair</button></form>
                        }
                        else if (!Model.Actor.IsGlobal)
                        {
                            <span class="hint">Ask your Nightware operator to @(d.NeedsRepair ? "repair" : "fix") it.</span>
                        }
                        @if (served)
                        {
                            <a asp-page="/Entities/Dns" asp-route-id="@d.Entity.Id" asp-route-domain="@d.Domain.Domain.Name">DNS records</a>
                        }
                    </li>
                }
            </ul>
        }
        @if (Model.Attention.NotChecked.Count > 0)
        {
            <p class="hint">Not checked: @string.Join(", ", Model.Attention.NotChecked.Select(e => e.Name)). Too many users to read here, or a system could not be reached; open the entity to look.</p>
        }
    }
</section>

<section class="panel">
    <h2>@(Model.Actor.IsGlobal ? "Entities" : "Your entities")</h2>
    @if (Model.Entities.Count == 0)
    {
        <p>No entities yet. @if (Model.Actor.IsGlobal) { <a asp-page="/Entities/Index">Create the first one</a> }</p>
    }
    else
    {
        <table>
            <thead><tr><th>Entity</th><th>Domains</th><th>Users</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
            @foreach (var e in Model.Entities)
            {
                <tr>
                    <td><a asp-page="/Entities/Detail" asp-route-id="@e.Id">@e.Name</a></td>
                    <td data-label="Domains">@for (var i = 0; i < e.Domains.Count; i++)
                    {
                        var d = e.Domains[i];<a asp-page="/Entities/Dns" asp-route-id="@e.Id" asp-route-domain="@d.Name" title="@(Model.Actor.IsGlobal ? "DNS, SPF and DMARC" : "DNS records") for @d.Name">@d.Name</a>@(i < e.Domains.Count - 1 ? ", " : "")
                    }</td>
                    <td data-label="Users">@if (Model.Attention.UserCounts.TryGetValue(e.Id, out var count)) {@count} else {<span title="Could not be read">—</span>}</td>
                    <td><a asp-page="/Users/Index" asp-route-entity="@e.Id">Users</a> · <a asp-page="/Users/New" asp-route-entity="@e.Id">Add or link a user</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
</div>

<aside class="panel systems" aria-labelledby="systems-heading">
    <h2 id="systems-heading">Systems</h2>
    <ul class="plain">
        @foreach (var h in Model.Health)
        {
            var name = Systems.ShortName(h.Backend);
            var failed = h.Healthy ? Model.FailedFor(h.Backend) : [];
            var chip = !h.Healthy ? "error" : failed.Count > 0 ? "missing" : "linked";
            var label = $"{name}: {(!h.Healthy ? "Unreachable" : failed.Count > 0 ? $"Reachable, failed for {failed.Count}" : "OK")}";
            <li>
                @if (Model.AdminConsoleFor(h.Backend) is { } url)
                {
                    <a class="chip @chip" href="@url" target="_blank" rel="noopener noreferrer" title="@Systems.Name(h.Backend) admin console">@label</a>
                }
                else
                {
                    <span class="chip @chip">@label</span>
                }
                @if (!h.Healthy && !string.IsNullOrEmpty(h.Detail))
                {
                    <p class="hint detail">@Systems.Name(h.Backend): @h.Detail@(Model.Actor.IsGlobal ? "" : " " + Systems.TellOperator)</p>
                }
                else if (failed.Count > 0)
                {
                    <p class="hint detail">@(Model.Actor.IsGlobal
                        ? $"{Systems.Name(h.Backend)} answers its health check but failed to answer for {string.Join(", ", failed)}. It may be partly down; see Needs attention."
                        : $"{Systems.ShortName(h.Backend)} is not answering for {string.Join(", ", failed)}. {Systems.TellOperator}")</p>
                }
            </li>
        }
    </ul>
</aside>
</div>
