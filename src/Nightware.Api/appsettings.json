{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "https://auth.nightware.localhost/realms/nightware",
    "Audience": "nightware-api",
    "RequireHttpsMetadata": true,
    "ValidIssuers": []
  },
  "Discovery": {
    "GraphBaseUrl": "https://graph.nightware.localhost/v1.0",
    "GraphBetaBaseUrl": "https://graph.nightware.localhost/beta",
    "AuthorizationEndpoint": "https://auth.nightware.localhost/realms/nightware/protocol/openid-connect/auth",
    "TokenEndpoint": "https://auth.nightware.localhost/realms/nightware/protocol/openid-connect/token",
    "ClientId": "nightmail",
    "Scopes": [ "openid", "email", "profile", "offline_access" ]
  },
  "DeltaLinks": {
    "SigningKey": "",
    "Lifetime": "30.00:00:00"
  },
  "Jmap": {
    "SessionUrl": "https://mail.nightware.localhost/.well-known/jmap",
    "CredentialStrategy": "TokenExchange",
    "Audience": "stalwart"
  },
  "Dav": {
    "BaseUrl": "https://cloud.nightware.localhost/remote.php/dav",
    "OcsBaseUrl": "https://cloud.nightware.localhost/ocs/v2.php",
    "CredentialStrategy": "TokenExchange",
    "Audience": "nextcloud"
  },
  "Directory": {
    "KeycloakBaseUrl": "https://auth.nightware.localhost",
    "Realm": "nightware",
    "ClientId": "nightware-api",
    "ClientSecret": ""
  }
}
