{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestHeaderCount": 100,
      "MaxRequestLineSize": 8192,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "SecurityHeaders": {
    "HstsMaxAge": "365.00:00:00"
  },
  "Limits": {
    "MaxRequestBodyBytes": 67666666
  },
  "RequestTimeouts": {
    "Default": "00:00:25",
    "Transfer": "00:02:00",
    "TransferBodyThresholdBytes": 1000000
  },
  "RateLimiting": {
    "Enabled": true,
    "TokenLimit": 300,
    "TokensPerPeriod": 10,
    "ReplenishmentPeriod": "00:00:01",
    "ConcurrentRequestLimit": 32
  },
  "Telemetry": {
    "ServiceName": "nightware-api",
    "Otlp": {
      "Endpoint": "",
      "Protocol": "Grpc"
    }
  },
  "Auth": {
    "Authority": "https://nightware.localhost/auth/realms/nightware",
    "MetadataAddress": "",
    "Audience": "nightware-api",
    "RequireHttpsMetadata": true,
    "ValidIssuers": []
  },
  "Discovery": {
    "GraphBaseUrl": "https://nightware.localhost/graph/v1.0",
    "GraphBetaBaseUrl": "https://nightware.localhost/graph/beta",
    "AuthorizationEndpoint": "https://nightware.localhost/auth/realms/nightware/protocol/openid-connect/auth",
    "TokenEndpoint": "https://nightware.localhost/auth/realms/nightware/protocol/openid-connect/token",
    "ClientId": "nightmail",
    "Scopes": [
      "openid",
      "email",
      "profile",
      "offline_access"
    ]
  },
  "DeltaLinks": {
    "SigningKey": "",
    "Lifetime": "30.00:00:00"
  },
  "Jmap": {
    "SessionUrl": "https://nightware.localhost/.well-known/jmap"
  },
  "Dav": {
    "BaseUrl": "https://nightware.localhost/cloud/",
    "DavRoot": "/remote.php/dav",
    "OcsRoot": "/ocs/v2.php"
  },
  "Directory": {
    "KeycloakBaseUrl": "https://nightware.localhost/auth",
    "Realm": "nightware",
    "ClientId": "nightware-api",
    "ClientSecret": "",
    "ServiceAccountScope": "kc-admin-api"
  },
  "BackendCredentials": {
    "Mail": {
      "Strategy": "TokenExchange",
      "Audience": "stalwart"
    },
    "Groupware": {
      "Strategy": "TokenExchange",
      "Audience": "nextcloud"
    }
  }
}
