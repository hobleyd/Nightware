# TLS and routing for the Nightware dev stack: one public host, one path prefix
# per backend.
#
# CADDY_TLS is one of
#   internal (default)  Caddy's local CA (root at /data/caddy/pki/authorities/local/root.crt;
#                       bootstrap.sh exports it to deploy/.certs/caddy-root.crt)
#   <ACME email>        publicly trusted certificates for a resolvable PUBLIC_HOST
#   "/certs/fullchain.crt /certs/privkey.key"
#                       files you supply in deploy/.certs (scripts/fetch-cert.sh)
{
	https_port {$HTTPS_PORT:443}
	auto_https disable_redirects
	admin 127.0.0.1:2019
	skip_install_trust
}

{$PUBLIC_HOST:nightware.localhost} {
	tls {$CADDY_TLS:internal}
	encode gzip

	# NightMail's server discovery is the façade's, at the host root.
	handle /.well-known/nightware {
		reverse_proxy nightware-api:8080
	}
	redir /.well-known/carddav /cloud/remote.php/dav/ 301
	redir /.well-known/caldav /cloud/remote.php/dav/ 301

	# Keycloak serves under /auth itself (KC_HTTP_RELATIVE_PATH), so no stripping.
	# Stalwart's own OAuth endpoints share the prefix (its web admin signs in
	# through them), but none of these exact paths is one of Keycloak's, which
	# all sit under /auth/realms, /auth/admin, /auth/resources and /auth/js.
	redir /auth /auth/ 301
	handle /auth/* {
		@stalwart-oauth path /auth/token /auth/userinfo /auth/jwks.json /auth/register /auth/device /auth/revoke /auth/logout /auth/introspect
		handle @stalwart-oauth {
			reverse_proxy stalwart:8080
		}
		handle {
			reverse_proxy keycloak:8080
		}
	}

	# Stalwart has no path prefix: its router matches root segments, and the
	# JMAP session advertises ${PUBLIC_URL}/jmap/... So JMAP lives at the root,
	# and so do the web admin (/admin, /account), its sign-in page (/login,
	# /device, /ui-*.js|css, /logo) and their APIs (/api/*, the OAuth discovery
	# documents). /mail/* is a stripped alias for the rest (healthz, WebDAV).
	@stalwart path /.well-known/jmap /.well-known/oauth-authorization-server /.well-known/openid-configuration /admin /admin/* /account /account/* /login /device /device/* /logo /logo/* /ui-* /api/* /calendar/rsvp
	handle @stalwart {
		reverse_proxy stalwart:8080
	}
	handle /jmap/* {
		reverse_proxy stalwart:8080
	}
	handle_path /mail/* {
		reverse_proxy stalwart:8080
	}

	# Nextcloud generates /cloud links itself (overwritewebroot) for requests
	# from this proxy's pinned address only (overwritecondaddr).
	redir /cloud /cloud/ 301
	handle_path /cloud/* {
		request_body {
			max_size 1GB
		}
		reverse_proxy nextcloud:80
	}

	# Collabora Online for Nextcloud Office, under its own service root
	# (net.service_root=/office), so the path is passed through. Document
	# conversion is for the façade only, which calls collabora:9980 directly:
	# through this proxy every client would arrive from Caddy's private address
	# and pass Collabora's post_allow check.
	handle /office/* {
		@convert path /office/cool/convert-to /office/cool/convert-to/* /office/lool/convert-to /office/lool/convert-to/*
		respond @convert 403
		reverse_proxy collabora:9980 {
			# Long-lived WebSocket editing sessions.
			flush_interval -1
		}
	}

	# Only answers when the `api` compose profile is up; 502 otherwise. The
	# façade builds its links on Discovery:GraphBaseUrl (.../graph/v1.0); the
	# prefix header covers anything built from the request instead.
	handle_path /graph/* {
		reverse_proxy nightware-api:8080 {
			header_up X-Forwarded-Prefix /graph
		}
	}

	# The admin console (ADR 0002), `api` profile. /admin is Stalwart's. Reachable
	# from ADMIN_ALLOWED_CIDRS only (default: anywhere; it still requires Keycloak
	# sign-in with MFA); everyone else gets 403.
	redir /console /console/ 301
	handle_path /console/* {
		@console-allowed remote_ip {$ADMIN_ALLOWED_CIDRS:0.0.0.0/0 ::/0}
		handle @console-allowed {
			reverse_proxy nightware-admin:8080 {
				header_up X-Forwarded-Prefix /console
			}
		}
		respond 403
	}

	# Grafana (telemetry) serves under /grafana itself (GF_SERVER_SERVE_FROM_SUB_PATH),
	# so the prefix is kept. Same network gate as the console; Grafana signs in
	# through Keycloak with the console's MFA, global administrators only.
	redir /grafana /grafana/ 301
	handle /grafana/* {
		@grafana-allowed remote_ip {$ADMIN_ALLOWED_CIDRS:0.0.0.0/0 ::/0}
		handle @grafana-allowed {
			reverse_proxy grafana:3000
		}
		respond 403
	}

	handle {
		redir * /cloud/ 302
	}
}
