# Nightware dev stack configuration. scripts/init-env.sh copies this to .env
# (git-ignored) and fills every empty secret below with a random value.

# Compose project name: containers, volumes and the network are prefixed with
# it. Every script and Makefile target reads it from here; two checkouts with
# different names (and DOCKER_SUBNETs) can keep separate stacks.
COMPOSE_PROJECT_NAME=nightware

# ---- Host / ports -----------------------------------------------------------
# The one public host. Caddy serves https://${PUBLIC_HOST}/auth (Keycloak),
# /cloud (Nextcloud), /office (Collabora), /graph (the façade), Stalwart's JMAP
# at the root (/.well-known/jmap, /jmap/), and /.well-known/nightware.
# *.localhost resolves to 127.0.0.1 in browsers and curl without /etc/hosts.
PUBLIC_HOST=nightware.localhost
# Domain of the mail addresses (alice@, bob@, rooms, Nextcloud's sender).
# Independent of PUBLIC_HOST. (BASE_DOMAIN, the old five-hostname setting, is
# only read as a fallback for both when they are absent.)
MAIL_DOMAIN=nightware.localhost
# Host interface Caddy and the mail ports bind to. 0.0.0.0 serves the LAN.
# Docker Desktop on macOS can bind only 127.0.0.1 or 0.0.0.0, not another
# specific address (a WireGuard interface, say).
BIND_ADDRESS=127.0.0.1
# HTTPS port Caddy publishes (and listens on inside its container).
HTTPS_PORT=443
# Must be ":${HTTPS_PORT}" when HTTPS_PORT is not 443, else empty. It is appended
# to the public URL (Keycloak issuer, Stalwart public URL, Nextcloud overwrite).
PUBLIC_PORT_SUFFIX=
# Subnet of the compose network. Stalwart skips spam filtering for mail from it
# (Nextcloud's iMIP invitations), so keep it private to this stack.
DOCKER_SUBNET=172.31.250.0/24
# The api container's fixed address on that network; Nextcloud exempts it from
# brute-force throttling (anonymous /shares lookups all come from it).
NIGHTWARE_API_ADDRESS=172.31.250.250
# Caddy's fixed address on that network; Nextcloud applies its /cloud URL
# overwrites to requests from it only. Both inside DOCKER_SUBNET.
CADDY_ADDRESS=172.31.250.253
# Stalwart mail ports published on the host (container ports 25 / 465 implicit-TLS submission / 993).
SMTP_PORT=2525
SUBMISSIONS_PORT=1465
IMAPS_PORT=1993
# Collabora's plain-HTTP port, for a façade run on the host. Keep it on
# loopback: elsewhere it offers document conversion to the whole network.
COLLABORA_BIND_ADDRESS=127.0.0.1

# ---- TLS --------------------------------------------------------------------
# CADDY_TLS is one of:
#   internal          Caddy's local CA (trust .certs/caddy-root.crt on client devices)
#   <email>           ACME (Let's Encrypt) for a publicly resolvable PUBLIC_HOST;
#                     needs inbound 443 or 80
#   "/certs/fullchain.crt /certs/privkey.key"
#                     your own certificate: put the files in deploy/.certs
#                     (scripts/fetch-cert.sh copies them from another host)
CADDY_TLS=internal
# With a publicly trusted certificate (not internal) set these three:
#   COLLABORA_SSL_VERIFICATION=true, STALWART_ALLOW_INVALID_CERTS=false,
#   NIGHTWARE_SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
COLLABORA_SSL_VERIFICATION=false
STALWART_ALLOW_INVALID_CERTS=true
NIGHTWARE_SSL_CERT_FILE=/certs/caddy-root.crt
# scripts/fetch-cert.sh (`make cert`): where to copy the certificate files from
# over ssh. The key is read with `docker run` on that host when it is root-only.
CERT_SOURCE_HOST=
CERT_SOURCE_CERT=
CERT_SOURCE_KEY=

# ---- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# Password of the realm test users alice@ and bob@${MAIL_DOMAIN}.
TEST_USER_PASSWORD=Nightware-Dev-1!
# NightMail web build origin; <origin>/callback.html is a registered redirect URI
# of the nightmail client and the origin is allowed for CORS.
NIGHTMAIL_WEB_ORIGIN=http://localhost:34572
# Confidential clients (realm import substitutes these).
NIGHTWARE_API_CLIENT_SECRET=
NIGHTWARE_DEV_CLIENT_SECRET=
NEXTCLOUD_OIDC_CLIENT_SECRET=

# ---- Nightware façade -------------------------------------------------------
# The façade's root secret (DeltaLinks:SigningKey): signs delta links and keys the
# seal on self-authorising upload/download URLs, which carry callers' access tokens.
# Required, at least 32 bytes, identical on every instance. Leave it empty here:
# deploy/scripts/init-env.sh (run by bootstrap.sh, `make stack`, `make api`) writes a
# random one into .env, or generate it yourself with `openssl rand -hex 32`.
# Changing it invalidates every stored delta link (clients fully resync) and every
# in-flight upload/download URL - see docs/operations/deployment.md.
NIGHTWARE_DELTA_LINK_KEY=

# ---- Stalwart ---------------------------------------------------------------
# Recovery administrator (also the master-user / impersonation credential).
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=
# Mail accounts stalwart/configure.sh creates (local parts at MAIL_DOMAIN).
STALWART_ACCOUNTS="alice bob"

# ---- Nextcloud --------------------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_DB_PASSWORD=

# ---- Admin console (/console, ADR 0002) ---------------------------------------
# Its own credentials in each backend; init-env.sh generates the secrets.
NIGHTWARE_ADMIN_CLIENT_SECRET=
STALWART_MANAGEMENT_USER=nightware-admin
STALWART_MANAGEMENT_PASSWORD=
# Only for the fallback when the account above cannot sign in (see deploy/README.md):
# STALWART_MANAGEMENT_LOGIN=admin and STALWART_MANAGEMENT_PASSWORD=<STALWART_ADMIN_PASSWORD>.
STALWART_MANAGEMENT_LOGIN=
NEXTCLOUD_PROVISIONING_USER=nightware-admin
NEXTCLOUD_PROVISIONING_PASSWORD=
# Address of the console container (Nextcloud exempts it from brute-force throttling).
NIGHTWARE_ADMIN_ADDRESS=172.31.250.249
# Who may reach /console (space-separated CIDRs). Default: anywhere; the console
# still requires Keycloak sign-in with MFA. Narrow it to a management network or VPN.
ADMIN_ALLOWED_CIDRS="0.0.0.0/0 ::/0"
# The acr the console requires at sign-in ("mfa" = Keycloak's OTP level). Empty
# turns the requirement off: only for a loopback dev stack whose test users have
# no authenticator, and refused when NIGHTWARE_ENVIRONMENT=Production.
ADMIN_REQUIRED_ACR=mfa
# Who becomes a global administrator of the console (usernames or addresses,
# space-separated); on a seeded dev stack, empty means alice. Others are granted
# from the console afterwards.
ADMIN_BOOTSTRAP_USERS=
# The entity keycloak/configure-console.sh creates for MAIL_DOMAIN; existing users
# with an @MAIL_DOMAIN address become its members.
NIGHTWARE_DEFAULT_ENTITY_NAME=Nightware
# Let entity admins delete mail/Nextcloud data of their own entity's disabled users.
ADMIN_ENTITY_ADMINS_MAY_DELETE_DATA=false
