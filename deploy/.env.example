# Nightware dev stack configuration. Copy to .env (git-ignored) and adjust.
# Every value here is a DEV DEFAULT — change all secrets for anything shared.

# ---- Hostnames / ports -------------------------------------------------------
# Public names are auth./mail./cloud./graph.${BASE_DOMAIN}. *.localhost resolves
# to 127.0.0.1 in browsers and curl without any /etc/hosts entry.
BASE_DOMAIN=nightware.localhost
# Host interface Caddy and the mail ports bind to.
BIND_ADDRESS=127.0.0.1
# HTTPS port Caddy publishes (and listens on inside its container).
HTTPS_PORT=443
# Must be ":${HTTPS_PORT}" when HTTPS_PORT is not 443, else empty. It is appended
# to every public URL (Keycloak issuer, Stalwart public URL, Nextcloud overwrite).
PUBLIC_PORT_SUFFIX=
# Subnet of the compose network. Stalwart skips spam filtering for mail from it
# (Nextcloud's iMIP invitations), so keep it private to this stack.
DOCKER_SUBNET=172.31.250.0/24
# The api container's fixed address on that network; Nextcloud exempts it from
# brute-force throttling (anonymous /shares lookups all come from it).
NIGHTWARE_API_ADDRESS=172.31.250.250
# Stalwart mail ports published on the host (container ports 25 / 465 implicit-TLS submission / 993).
SMTP_PORT=2525
SUBMISSIONS_PORT=1465
IMAPS_PORT=1993

# TLS for the public names: "internal" = Caddy's local CA (trust
# .certs/caddy-root.crt on client devices), or an ACME account email for a real,
# publicly resolvable BASE_DOMAIN (Let's Encrypt; needs inbound 443 or 80).
CADDY_TLS=internal

# ---- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=nightware-kc-admin
KEYCLOAK_DB_PASSWORD=nightware-kc-db
# Password of the realm test users alice@ and bob@${BASE_DOMAIN}.
TEST_USER_PASSWORD=Nightware-Dev-1!
# NightMail web build origin; <origin>/callback.html is a registered redirect URI
# of the nightmail client and the origin is allowed for CORS.
NIGHTMAIL_WEB_ORIGIN=http://localhost:34572
# Confidential clients (realm import substitutes these).
NIGHTWARE_API_CLIENT_SECRET=nightware-api-dev-secret
NIGHTWARE_DEV_CLIENT_SECRET=nightware-dev-secret
NEXTCLOUD_OIDC_CLIENT_SECRET=nextcloud-oidc-dev-secret

# ---- Nightware façade -------------------------------------------------------
# The façade's root secret (DeltaLinks:SigningKey): signs delta links and keys the
# seal on self-authorising upload/download URLs, which carry callers' access tokens.
# Required, at least 32 bytes, identical on every instance. Leave it empty here:
# deploy/scripts/init-env.sh (run by bootstrap.sh, `make stack`, `make api`) writes a
# random one into .env, or generate it yourself with `openssl rand -hex 32`.
# Changing it invalidates every stored delta link (clients fully resync) and every
# in-flight upload/download URL - see docs/operations/deployment.md.
NIGHTWARE_DELTA_LINK_KEY=

# ---- Stalwart ---------------------------------------------------------------
# Recovery administrator (also the master-user / impersonation credential).
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=nightware-stalwart-admin

# ---- Nextcloud --------------------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=nightware-nc-admin
NEXTCLOUD_DB_PASSWORD=nightware-nc-db
