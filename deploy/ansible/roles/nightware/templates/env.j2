# Managed by ansible (deploy/ansible/roles/nightware): deploy/.env for
# docker-compose.yml and the configure scripts. Edits here are overwritten.

COMPOSE_PROJECT_NAME=nightware
NIGHTWARE_ENVIRONMENT=Production

PUBLIC_HOST={{ nightware_public_host }}
MAIL_DOMAIN={{ nightware_mail_domain }}
HTTPS_PORT={{ nightware_https_port }}
PUBLIC_PORT_SUFFIX={{ '' if nightware_https_port | int == 443 else ':' ~ nightware_https_port }}
BIND_ADDRESS={{ nightware_bind_address }}
# The configure scripts reach Caddy on this host, whatever DNS says.
NIGHTWARE_CONNECT_ADDRESS={{ '127.0.0.1' if nightware_bind_address in ['0.0.0.0', '127.0.0.1'] else nightware_bind_address }}
CADDY_TLS="{{ nightware_tls }}"
# The certificate is publicly trusted (ACME or your own files).
COLLABORA_SSL_VERIFICATION=true
STALWART_ALLOW_INVALID_CERTS=false
NIGHTWARE_SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# Without the dev stack's test users and nightware-dev client (files/production-realm.jq).
KEYCLOAK_REALM_FILE=./keycloak/nightware-realm.production.json
NIGHTMAIL_WEB_ORIGIN={{ nightware_web_origin }}
NIGHTWARE_OTLP_ENDPOINT={{ nightware_otlp_endpoint }}

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD={{ nightware_keycloak_admin_password }}
KEYCLOAK_DB_PASSWORD={{ nightware_keycloak_db_password }}
NIGHTWARE_API_CLIENT_SECRET={{ nightware_api_client_secret }}
NEXTCLOUD_OIDC_CLIENT_SECRET={{ nightware_nextcloud_oidc_client_secret }}
NIGHTWARE_DELTA_LINK_KEY={{ nightware_delta_link_key }}
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD={{ nightware_stalwart_admin_password }}
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD={{ nightware_nextcloud_admin_password }}
NEXTCLOUD_DB_PASSWORD={{ nightware_nextcloud_db_password }}

# The admin console.
NIGHTWARE_ADMIN_CLIENT_SECRET={{ nightware_admin_client_secret }}
NEXTCLOUD_PROVISIONING_PASSWORD={{ nightware_nextcloud_provisioning_password }}
ADMIN_REQUIRED_ACR=mfa
ADMIN_ALLOWED_CIDRS="{{ nightware_admin_allowed_cidrs }}"
ADMIN_BOOTSTRAP_USERS="{{ nightware_users | selectattr('admin', 'defined') | selectattr('admin') | map(attribute='username') | join(' ') }}"
NIGHTWARE_DEFAULT_ENTITY_NAME="{{ nightware_default_entity_name }}"
# Minted by stalwart/configure.sh, which writes them here; carried over from
# the file this one replaced.
STALWART_MANAGEMENT_API_KEY={{ nightware_stalwart_key | default('') }}
STALWART_MANAGEMENT_API_KEY_ID={{ nightware_stalwart_key_id | default('') }}

# Grafana (/grafana).
NIGHTWARE_GRAFANA_CLIENT_SECRET={{ nightware_grafana_client_secret }}
GRAFANA_ADMIN_PASSWORD={{ nightware_grafana_admin_password }}

# Mailboxes stalwart/configure.sh creates: nightware_users' local parts.
STALWART_ACCOUNTS="{{ nightware_users | map(attribute='email') | map('regex_replace', '@.*$', '') | join(' ') }}"
# No test users to seed.
NIGHTWARE_KC_SEED=0
# Not used outside development. Set so scripts/init-env.sh, which fills every
# empty secret with a random value, leaves this file as written.
NIGHTWARE_DEV_CLIENT_SECRET=unused
TEST_USER_PASSWORD=unused
