{
  "operationId": "mail.messages.search",
  "provenance": "Graph docs example (list messages with $search), trimmed to the list projection; KQL rewrite from graph_api_datasource_impl.dart:462",
  "request": {
    "method": "GET",
    "path": "/v1.0/me/messages",
    "query": {
      "$top": "50",
      "$select": "id,subject,from,toRecipients,ccRecipients,bccRecipients,bodyPreview,isRead,flag,receivedDateTime,sentDateTime,importance,conversationId,hasAttachments,parentFolderId",
      "$search": "\"from:alex@example.com hasAttachments:true\""
    },
    "headers": {
      "Authorization": "Bearer {token}",
      "Accept": "application/json"
    },
    "body": null
  },
